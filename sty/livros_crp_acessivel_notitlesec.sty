%
% eso-pic é ativamente mantido, tem API limpa e integra bem
% com tagging. Comandos principais:
%
%   \AddToShipoutPictureBG{...}   — aplica a TODAS as páginas
%   \AddToShipoutPictureBG*{...}  — aplica só à página atual
%   \AddToShipoutPictureFG{...}   — foreground, idem acima
%
% Exemplo típico no .tex do documento (arte do designer
% ocupando a página inteira, atrás do texto):
%
%   \AddToShipoutPictureBG*{%
%       \AtPageLowerLeft{%
%           \includegraphics[
%               width=\paperwidth,
%               height=\paperheight,
%               alt={}% <- vazio: marca como artefato decorativo
%           ]{arte_capa.pdf}%
%       }%
%   }
%
% NOTA PDF/UA: arte puramente decorativa deve receber alt={}
% (string vazia), que instrui o leitor de tela a ignorar a
% imagem. Arte informativa precisa de alt={descrição real}.
\usepackage{eso-pic}

