\newcommand{\caixasel}[2]{\centering\raisebox{-2pt}{\fbox{\CheckBox[name=#2,bordercolor=black, height=#1pt, width=#1pt]{\null}}}}
\newcommand{\preenctext}[4]{\noindent\TextField[name=#2, width=#3, bordercolor=gray, color=black, backgroundcolor=white, height=#1pt]{#4}}
\newcommand{\dataabrev}[2]{%
    \preenctext{#1}{dia{#2}}{3em}{\null} / %
    \preenctext{#1}{mes{#2}}{3em}{\null} / %
    \preenctext{#1}{ano{#2}}{4em}{\null}%
}
\newcommand{\dataextenso}[1]{%
\raggedright%
\TextField[name=diaext{#1}, width=3em, bordercolor=gray, color=black, backgroundcolor=white, height=14pt]{São Paulo, }%
\TextField[name=mesext{#1}, width=10em, bordercolor=gray, color=black, backgroundcolor=white, height=14pt]{ de } %
\TextField[name=anoext{#1}, width=5em, bordercolor=gray, color=black, backgroundcolor=white, height=14pt]{ de } .}