\makeatletter
\makechapterstyle{CRP}{%
    \setlength{\afterchapskip}{40pt}
    \renewcommand*{\chapterheadstart}{\vspace*{40pt}}
    \renewcommand*{\afterchapternum}{\par\nobreak\vskip 10pt}
    \renewcommand*{\chapnamefont}{\normalfont\Large\flushleft\sffamily}
    \renewcommand*{\chapnumfont}{\bfseries\huge\sffamily}
    \renewcommand*{\chaptitlefont}{\normalfont\huge\bfseries\flushleft\sffamily\color{crp1}}
    \renewcommand*{\printchaptername}{}%\color{crp1}}
    \renewcommand*{\chapternamenum}{}

    \newlength{\redbarheight}
    \setlength{\redbarheight}{0.5em}		% Setting the height of the bar

    \newlength{\chapnumboxlength}
    \setlength{\chapnumboxlength}{2em}	% Setting the length of the box containing chapter number

    \newlength{\leftbarlength}
    \setlength{\leftbarlength}{1em}  		% Setting length of the bar left to the chapter number

    \newlength{\chapnumboxheight}
    \setlength{\chapnumboxheight}{10pt}

    \newlength{\rightbarlength}
    \setlength{\rightbarlength}{\textwidth}
    \addtolength{\rightbarlength}{-\leftbarlength}
    \addtolength{\rightbarlength}{-\chapnumboxlength}	% Adjusting the right bar to fit the text margin
    \addtolength{\rightbarlength}{-0.5em} % "By eye" adjustment.. - shouldn't really be there :(

    \renewcommand*{\printchapternum}{%
        \makebox[0pt][l]{%
            \color{crp2}\rule{\leftbarlength}{\redbarheight}											% Left bar
            \resizebox{\chapnumboxlength}{!}{\color{crp1}\chapnumfont\thechapter}	% Chapter number
            \color{crp2}\rule{\rightbarlength}{\redbarheight}											% Right bar
        }%
    }%
}
\makeatother
