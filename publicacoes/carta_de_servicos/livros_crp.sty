% ------------------- %
\newcommand{\CreditoInstitucionalUm}[1]{%
    \begin{flushleft}
        \large\bfseries\color{crp2}#1
        \vspace{-2.5\baselineskip}
    \end{flushleft}}
\newcommand{\CreditoInstitucionalDois}[1]{%
    \begin{flushleft}
        \small\bfseries\color{crp3}#1
        \vspace{-3\baselineskip}
    \end{flushleft}}
\newcommand{\CreditoTecnicoUm}[1]{%
    \begin{flushright}
        \large\bfseries\color{crp2}#1
    \end{flushright}}
\newcommand{\CreditoTecnicoDois}[1]{%
    \begin{flushright}
    \normalsize\bfseries\color{crp3}#1
    \end{flushleft}}
\newenvironment{CreditoInstitucional}%
{\begin{flushleft}%
        \noindent%
        \footnotesize
        \setasuspacing{\SingleSpacing}}
        {\end{flushleft}}
