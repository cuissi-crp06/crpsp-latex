% --- Redefinições manuais de estilos de seção ---
% Substituem o bloco \titleformat/\titlespacing que usava titlesec.
% A formatação é feita sobrescrevendo os comandos internos do
% book.cls: \@makechapterhead (conteúdo da abertura de capítulo)
% e o formato padrão de \section, \subsection etc. via \@startsection.
%
% \chapter: definido em book.cls via \@makechapterhead e
% \@makeschapterhead. Redefinimos os dois com o estilo CRP.

\makeatletter

% --- Capítulo numerado ---
% NOTA: com secnumdepth=-1 nenhum capítulo exibe número, então o
% bloco \if@mainmatter...\fi que imprimiria "Capítulo N" fica
% simplesmente omitido. O resultado é só o título.
\renewcommand\@makechapterhead[1]{%
    \vspace*{50\p@}%
    {\parindent \z@ \raggedright \normalfont
     \interlinepenalty\@M
     \huge\bfseries\sffamily\color{crp2} #1\par\nobreak
     \vskip 8\baselineskip
    }%
}

% --- Capítulo não-numerado (\chapter*) ---
\renewcommand\@makeschapterhead[1]{%
    \vspace*{50\p@}%
    {\parindent \z@ \raggedright \normalfont
     \interlinepenalty\@M
     \huge\bfseries\sffamily\color{crp2} #1\par\nobreak
     \vskip 8\baselineskip
    }%
}

% --- Partes ---
% A parte usa \@part e \@endpart em book.cls. Em vez de mexer
% nesses comandos internos (que são complexos e interagem com
% page breaks), redefinimos \part via wrapper que ajusta a
% formatação do título.
%
% Abordagem: deixar \part do book.cls emitir sua estrutura
% normal, mas mudar \partname (se quiséssemos "Parte" em
% português, o babel já faz isso) e o estilo via \huge etc.
%
% Para controle visual: redefinir \@makepartnumber e o formato
% interno. Mas book.cls não separa esses componentes limpamente.
% Alternativa: aceitar o layout default do book (número + título
% centrados no meio da página) e só aplicar cor e fonte via
% redefinição direta.

\renewcommand\part{%
    \if@openright\cleardoublepage\else\clearpage\fi
    \thispagestyle{plain}%
    \if@twocolumn\onecolumn\@tempswatrue\else\@tempswafalse\fi
    \null\vfil
    \secdef\@part\@spart}

\def\@part[#1]#2{%
    \ifnum \c@secnumdepth >-2\relax
        \refstepcounter{part}%
        \addcontentsline{toc}{part}{\thepart\hspace{1em}#2}%
    \else
        \addcontentsline{toc}{part}{#2}%
    \fi
    \markboth{}{}%
    {\centering
     \interlinepenalty \@M
     \normalfont
     \ifnum \c@secnumdepth >-2\relax
       \huge\bfseries\sffamily\color{crp1} \partname\nobreakspace\thepart
       \par
       \vskip 20\p@
     \fi
     \Huge \bfseries \sffamily \color{crp1} #2\par}%
    \@endpart}

\def\@spart#1{%
    {\centering
     \interlinepenalty \@M
     \normalfont
     \Huge \bfseries \sffamily \color{crp1} #1\par}%
    \@endpart}

% --- Seções via \@startsection ---
% \@startsection{name}{level}{indent}{beforeskip}{afterskip}{style}
% Negativo em afterskip = inline (runin); positivo = display
\renewcommand\section{%
    \@startsection{section}{1}{\z@}%
        {-2\baselineskip \@plus -\p@ \@minus -.2ex}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\Large\bfseries}}

\renewcommand\subsection{%
    \@startsection{subsection}{2}{\z@}%
        {-1.5\baselineskip \@plus -\p@ \@minus -.2ex}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\normalsize\bfseries}}

\renewcommand\subsubsection{%
    \@startsection{subsubsection}{3}{\z@}%
        {-\baselineskip \@plus -\p@ \@minus -.2ex}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\normalsize\itshape}}

\renewcommand\paragraph{%
    \@startsection{paragraph}{4}{\z@}%
        {-0.5\baselineskip \@plus -\p@ \@minus -.2ex}%
        {-0.5em}%   % negativo: runin
        {\color{crp1}\sffamily\normalsize\bfseries}}

\renewcommand\subparagraph{%
    \@startsection{subparagraph}{5}{\parindent}%
        {-0.5\baselineskip \@plus -\p@ \@minus -.2ex}%
        {-0.5em}%
        {\color{crp1}\sffamily\normalsize}}

\makeatother


