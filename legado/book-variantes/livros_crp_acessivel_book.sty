% --- Subtítulo de abertura ---
% \vspace negativo é intencional: sobrepõe o espaço pós-capítulo
% para posicionar o subtítulo imediatamente abaixo do título.
\newcommand{\SubTituloUm}[1]{%
    \vspace{-8\baselineskip}%
    \noindent\raggedright\large\itshape #1\par
    \normalfont\normalsize\color{black}\justifying
    \vspace{8\baselineskip}%
}

% --- Intertítulo ---
\newcommand{\Entretitulo}[1]{%
    \vspace{0.618\baselineskip}%
    \noindent\color{crp1}\Light #1\par
    \vspace{0.382\baselineskip}%
    \normalfont\normalsize\color{black}%
}

% --- Filete decorativo ---
\newcommand{\setetoques}{\rule{6em}{0.4pt}}

% --- Identificadores de plenário ---
\newcommand{\xviplenario} {\textbf{XVI Plenário}}
\newcommand{\xviiplenario}{\textbf{XVII Plenário}}

% --- Bloco de assinatura institucional ---
\newcommand{\assinaapresenta}[1]{%
    \begin{flushright}
        \noindent
        Conselho Regional de Psicologia de São Paulo\\
        #1%
    \end{flushright}
    \justifying
    \setasuspacing{\onehalfspacing}%
}

% --- Assinatura centrada (nome + cargo) ---
\newcommand{\LegAssina}[2]{%
    \begin{center}
        #1\\
        #2
    \end{center}
}

% --- Título centrado em negrito ---
\newcommand{\LegTitulo}[1]{%
    \begin{center}
        \textbf{#1}
    \end{center}
}

% --- Ementa de legislação ---
% Offset de 6cm à esquerda via minipage.
%
% NOTA PDF/UA: o mecanismo de minipage pode gerar warning de ordem
% de leitura no tagpdf em documentos futuros. Mantido por decisão
% do usuário (compatibilidade visual). Investigar quando o upstream
% do latex-lab estabilizar o suporte a minipages.
\newcommand{\LegEmenta}[1]{%
    \noindent
    \begin{minipage}{6cm}\hfill\end{minipage}%
    \begin{minipage}{\boxementa}%
        \justifying\sffamily\footnotesize\noindent #1%
    \end{minipage}\par
}

% --- Artigo de lei ---
% Sem argumento opcional: phase-III/block intercepta \begin{description}
% e rejeita chaves de enumitem (align, leftmargin, labelwidth, labelsep).
% \setlist afeta apenas a sessão de enumitem; block usa seu próprio
% pipeline. Aceita-se a indentação padrão do description do book.
\newcommand{\LegArtigo}[2]{%
    \begin{description}
        \item[\,#1\,] #2%
    \end{description}
}

% --- Parágrafo de lei (numerado ou único) ---
% Argumento #1: label completo (ex.: "§ 1º" ou "Parágrafo único.").
%
% NOTA PDF/UA: usa minipage para controlar recuo visual. Mesma
% situação de \LegEmenta — mantido por decisão do usuário.
\newcommand{\LegParagrafo}[2]{%
    \noindent
    \begin{minipage}{\indicartigo-0.5em}\hfill\end{minipage}%
    \begin{minipage}{\linewidth-1.5\indicartigo+1em}%
        \textbf{#1} #2%
    \end{minipage}\par
}

% \LegParagrafoUnico: alias semântico.
\let\LegParagrafoUnico\LegParagrafo

% --- Caso (abertura de caso clínico/ético) ---
\newcommand{\Caso}[1]{%
    \clearpage
    \begin{center}
        \color{crp1}\sffamily\textbf{#1}%
    \end{center}
}

