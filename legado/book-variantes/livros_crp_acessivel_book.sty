\let\CreditoInstitucionalDestaque\CreditoInstitucional
\let\endCreditoInstitucionalDestaque\endCreditoInstitucional

% Cabeçalho de seção de créditos (nível 1): normalsize, negrito, crp1.
\newcommand{\CreditoInstitucionalUm}[1]{%
    \raggedright
    {\sffamily\normalsize\bfseries\color{crp1}#1}\par
}

% Cabeçalho de seção de créditos (nível 2): footnotesize, negrito, crp1.
\newcommand{\CreditoInstitucionalDois}[1]{%
    \raggedright
    \vspace{0.2\baselineskip}%
    {\sffamily\footnotesize\bfseries\color{crp1}#1}\par
    \vspace*{1.3\baselineskip}%
}

% --- Linha de crédito técnico: label (30%) + valor (61.8%) ---
% REFATORADO: substituiu \begin{tabular}{p p} (proibido por PDF/UA)
% por \parbox duplo lado a lado.
% Interface preservada: \CreditoTecnico{label}{valor}
\newcommand{\CreditoTecnico}[2]{%
    \begin{CreditoInstitucional}
        \vspace{-1.618\baselineskip}%
        \noindent
        \parbox[t]{0.3\linewidth}{%
            \sffamily\scriptsize\bfseries\color{crp1}#1}%
        \parbox[t]{0.618\linewidth}{%
            \normalfont\color{black}#2}\par
        \vspace{-1\baselineskip}%
    \end{CreditoInstitucional}
}

% --- Lista de cargos: duas colunas (60% + 40%) ---
% REFATORADO: substituiu \begin{tabular}{p p} por \parbox duplo.
% MUDANÇA DE INTERFACE: agora requer dois argumentos separados
% (coluna esquerda e coluna direita) em vez de um bloco tabular.
% Documentos existentes que usavam \CargoNosCreditos{col1 & col2 \\}
% devem ser atualizados para \CargoNosCreditos{col1}{col2}.
\newcommand{\CargoNosCreditos}[2]{%
    \par\vspace{\baselineskip}
    \sffamily\scriptsize\raggedright
    \noindent
    \parbox[t]{0.6\linewidth}{\singlespacing\sffamily\scriptsize\raggedright  #1}%
    \parbox[t]{0.4\linewidth}{\singlespacing\sffamily\scriptsize\raggedright  #2}%\par
    %\vspace{1.382\baselineskip}%
}

% --- Lista de nomes: parágrafo único ---
