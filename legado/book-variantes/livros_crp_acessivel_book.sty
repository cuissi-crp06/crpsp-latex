% xurl antes de hyperref — estende regras de quebra de URL.
% NOTA: a opção urlbreaks requer que url não tenha sido carregado
% antes. Com \DocumentMetadata ativo, pdfmanagement pode carregar
% url antecipadamente — por isso não usamos urlbreaks aqui.
\usepackage[obeyspaces, spaces, hyphens]{xurl}
\usepackage{hyperref}

% \DocumentMetadata já configura título, autor, idioma via XMP.
% hypersetup aqui cuida apenas da aparência dos links e de
% pdfdisplaydoctitle (exigido por PDF/UA).
\hypersetup{
    colorlinks         = true,
    linkcolor          = black,
    filecolor          = black,
    urlcolor           = crp1,
    pdfdisplaydoctitle = true,
    bookmarksopen      = true,
    bookmarksnumbered  = false,
}
\urlstyle{same}


