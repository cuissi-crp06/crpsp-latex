\ProvidesFile{crpsp-abnt.bbx}[2026/09/28 v0.2.1-alfa Extensao do biblatex-abnt para a NBR 6023:2025]%
%
% Estende o biblatex-abnt: carrega o estilo dele e sobrepõe só o que diverge
% da ABNT NBR 6023:2025. Plano e medidas: briefings/briefing-crpsp-abnt.md e
% desenvolvimento/corpus/DIVERGENCIAS.md.
%
\RequireBibliographyStyle{abnt}

% Opções >>>1
%
% - slashdaterange: intervalo de meses com barra, "jul./ago. 2009" (6023, 7.7.5);
% - maxbibnames=20, minbibnames=20: a referência traz todos os autores, até 20
%   (8.1.1.2 diz que "convém indicar todos"); acima disso, os 20 primeiros e
%   et al.;
% - maxcitenames=3, mincitenames=1: a chamada de quatro ou mais autores é o
%   primeiro e et al. (10520, 6.1.4, que admite as duas formas). Decisões do
%   Angelo, 2026-09-28; README, "Opções fixadas".

\ExecuteBibliographyOptions{%
  slashdaterange,%
  maxbibnames=20,%
  minbibnames=20,%
  maxcitenames=3,%
  mincitenames=1,%
}

% <<<1

% Intervalos e pontuação (DIVERGENCIAS.md, linhas 1 e 2) >>>1
%
% Intervalo de páginas com hífen, "p. 1-74", não meia-risca.
\DefineBibliographyExtras{brazilian}{\protected\def\bibrangedash{-}}
\DefineBibliographyExtras{portuguese}{\protected\def\bibrangedash{-}}
\DefineBibliographyExtras{english}{\protected\def\bibrangedash{-}}

% "Anais [...]." O ponto de \ldots atravessava o colchete (sfcode 0) e o
% biblatex tomava a unidade por já pontuada. Com o colchete opaco, a pontuação
% seguinte entra: "[...].", "[2016].", "[S. l.]:".
\AtBeginBibliography{\sfcode`\]=1000\relax}

% <<<1

% Páginas com prefixo de letra >>>1
%
% "p. E16-E18": o upstream passava o campo inteiro por \MakeLowercase, e o
% \mkpageprefix só põe "p." quando o valor é numeral. Saía "e16-e18". Aqui a
% caixa do valor fica como está no .bib, e o prefixo entra também quando cada
% ponta do intervalo é uma ou duas letras seguidas de algarismos. Número de
% artigo ("e03304", 6023, 7.7.6) vai em eid, que sai sem "p.".
\ExplSyntaxOn
\tl_new:N \l__crpsp_paginacao_tl
\cs_new_protected:Npn \crpsp_pages:n #1
  {
    \regex_match:nnTF
      { \A [A-Za-z]{1,2} \d+ (?: \c{bibrangedash} \s* [A-Za-z]{0,2} \d+ )? \Z }
      {#1}
      {
        \iffieldundef { bookpagination }
          { \tl_set:Nn \l__crpsp_paginacao_tl { page } }
          { \tl_set:Ne \l__crpsp_paginacao_tl { \thefield { bookpagination } } }
        \tl_if_in:nnTF {#1} { \bibrangedash }
          { \bibstring { \l__crpsp_paginacao_tl s } }
          { \bibstring { \l__crpsp_paginacao_tl } }
        \ppspace #1
      }
      { \mkpageprefix [bookpagination] {#1} }
  }
\DeclareFieldFormat* { pages } { \midsentence \crpsp_pages:n {#1} }
\ExplSyntaxOff

% <<<1

% Folhas (DIVERGENCIAS.md, linha 11) >>>1
%
% bookpagination = {leaf}: "82 f." e "f. 19-20" (6023, 7.1.2 e 7.3). O
% biblatex e o .lbx do upstream não têm as strings de folha, e a paginação
% caía em "p.".
\NewBibliographyString{leaf,leafs,leaftotal,leaftotals}
\DefineBibliographyStrings{brazilian}{%
  leaf = {f\adddot}, leafs = {f\adddot},%
  leaftotal = {f\adddot}, leaftotals = {f\adddot},%
}
\DefineBibliographyStrings{portuguese}{%
  leaf = {f\adddot}, leafs = {f\adddot},%
  leaftotal = {f\adddot}, leaftotals = {f\adddot},%
}

% <<<1

% DOI (DIVERGENCIAS.md, linha 6) >>>1
%
% A 6023:2025 não fixa a forma do DOI, e os exemplos trazem três: sem
% resolvedor (7.2.2, ex. 6), "http://dx.doi.org/..." (7.7.6, ex. 7) e
% "https://doi.org/..." (7.7.6, ex. 8, novo na 2025). O estilo imprime o doi
% como vem no .bib e o torna link. A forma é do dado; o README recomenda a do
% ex. 8. O upstream cortava o resolvedor e imprimia só o sufixo.
\ExplSyntaxOn
\cs_new_protected:Npn \crpsp_doi:n #1
  {
    \str_if_eq:eeTF { \str_range:nnn {#1} {1} {4} } { http }
      { \url {#1} }
      {
        \ifhyperref
          { \href { https://doi.org/#1 } { \nolinkurl {#1} } }
          { \nolinkurl {#1} }
      }
  }
\DeclareFieldFormat{doi}{\mkbibacro{DOI}\addcolon\space\crpsp_doi:n {#1}}
\ExplSyntaxOff

% <<<1

% Qualificador da pessoa jurídica (DIVERGENCIAS.md, linha 3) >>>1
%
% "INSTITUTO NACIONAL DO CÂNCER (Brasil)", "SÃO PAULO (Estado). Secretaria do
% Meio Ambiente", "EMMANUEL (Espírito)": a caixa alta vale até o primeiro
% parêntese (6023, 8.1.2). O upstream passava o nome inteiro por
% \MakeUppercase em \UpperOrSC, que só serve às partes do nome.
\ExplSyntaxOn
\prg_generate_conditional_variant:Nnn \tl_if_single:n { V } { p }
\prg_generate_conditional_variant:Nnn \tl_if_head_is_group:n { V } { p }
\cs_new:Npn \__crpsp_qualificador:w #1 ( #2 \q_stop
  {
    \iftoggle{scbib}
      { \textsc { \MakeLowercase {#1} } }
      { \MakeUppercase {#1} }
    ( #2
  }
\tl_new:N \l__crpsp_nome_tl
\RenewDocumentCommand \UpperOrSC { m }
  {
    \group_begin:
    \let \MakeCapital \relax
    \tl_set:Nn \l__crpsp_nome_tl {#1}
    % o nome chega como \namepartfamily, e o conteúdo, entre chaves
    \bool_lazy_and:nnT
      { \tl_if_single_token_p:n {#1} }
      { \token_if_macro_p:N #1 }
      { \tl_set:No \l__crpsp_nome_tl {#1} }
    \bool_lazy_and:nnT
      { \tl_if_single_p:V \l__crpsp_nome_tl }
      { \tl_if_head_is_group_p:V \l__crpsp_nome_tl }
      { \tl_set:Ne \l__crpsp_nome_tl { \exp_last_unbraced:No \exp_not:n \l__crpsp_nome_tl } }
    \tl_if_in:NnTF \l__crpsp_nome_tl { ( }
      { \exp_last_unbraced:NV \__crpsp_qualificador:w \l__crpsp_nome_tl \q_stop }
      {
        \iftoggle{scbib}
          { \textsc { \MakeLowercase {#1} } }
          { \MakeUppercase {#1} }
      }
    \group_end:
  }
\ExplSyntaxOff

% <<<1

% Entrada pelo título iniciado por artigo (6023, 8.2.1) >>>1
%
% "A FLOR prometida", "THE EVIDENCE underlying...": o artigo e a palavra
% seguinte em maiúsculas. O upstream subia só a primeira palavra, e o artigo
% ficava sozinho. Entram também as contrações de preposição e artigo, como no
% exemplo "NOS CANAVIAIS" da 10520 (6.1.1.4). A lista não é exaustiva.
\ExplSyntaxOn
\clist_const:Nn \c__crpsp_artigos_clist
  {
    a, o, as, os, um, uma, uns, umas,
    à, às, ao, aos, no, na, nos, nas, do, da, dos, das,
    num, numa, pelo, pela, pelos, pelas,
    the, an, el, la, los, las, lo, un, una, le, les, une, der, die
  }
\seq_new:N \l__crpsp_titulo_seq
\tl_new:N \l__crpsp_palavra_tl
\bool_new:N \l__crpsp_artigo_bool
\RenewDocumentCommand \FirstWordUpper { m }
  {
    \seq_set_split_keep_spaces:Nnn \l__crpsp_titulo_seq { ~ } {#1}
    \seq_remove_all:Nn \l__crpsp_titulo_seq { }
    \bool_set_false:N \l__crpsp_artigo_bool
    \seq_pop_left:NN \l__crpsp_titulo_seq \l__crpsp_palavra_tl
    \seq_if_empty:NF \l__crpsp_titulo_seq
      {
        \clist_map_inline:Nn \c__crpsp_artigos_clist
          {
            \str_if_eq:eeT
              { \text_lowercase:n { \tl_to_str:N \l__crpsp_palavra_tl } }
              { \tl_to_str:n {##1} }
              { \bool_set_true:N \l__crpsp_artigo_bool \clist_map_break: }
          }
      }
    \bool_if:NTF \l__crpsp_artigo_bool
      {
        \MakeUppercase
          {
            \l__crpsp_palavra_tl \c_space_tl
            \seq_item:Nn \l__crpsp_titulo_seq { 1 }
          }
        \seq_pop_left:NN \l__crpsp_titulo_seq \l__crpsp_palavra_tl
      }
      { \MakeUppercase { \l__crpsp_palavra_tl } }
    \seq_if_empty:NF \l__crpsp_titulo_seq
      { \c_space_tl \seq_use:Nn \l__crpsp_titulo_seq { ~ } }
  }
\ExplSyntaxOff

% <<<1

% @manual com editora (DIVERGENCIAS.md, linha 12) >>>1
%
% "Rio de Janeiro: ABNT, 2011." (6023, 8.1.2). O driver do upstream usa
% location+date e descarta a editora.
\xpatchbibdriver{manual}
  {\usebibmacro{location+date}}
  {\usebibmacro{publisher+location+date}}
  {}
  {\PackageWarning{crpsp-abnt}{Nao consegui corrigir o driver de @manual}}

% <<<1

% Sigla como entrada >>>1
%
% Pessoa jurídica com sigla entra pela sigla, travessão e nome por extenso:
% "IBGE — INSTITUTO BRASILEIRO DE GEOGRAFIA E ESTATÍSTICA." (decisão 3 do
% briefing). A forma não está na norma; é a combinação das duas que a 8.1.2
% admite. A lista é ordenada pela sigla, e a chamada sai com ela
% (shortauthor, que o upstream já usa como labelname).
%
% O sinal é automático (decisão de 2026-09-28): a entrada tem shortauthor, e o
% author é um nome só, inteiro entre chaves duplas, como se escreve pessoa
% jurídica no .bib. O mapa grava o campo interno crpspsigla, e a sigla vira a
% chave de ordenação, salvo se a entrada já tiver sortname.
\DeclareStyleSourcemap{%
  \maps[datatype=bibtex]{%
    \map{%
      \step[fieldsource=author,
            match=\regexp{\A\{[^\{\}]*(?:\{[^\{\}]*\}[^\{\}]*)*\}\z},
            final]%
      \step[fieldsource=shortauthor, final]%
      \step[fieldset=crpspsigla, fieldvalue={true}]%
      \step[notfield=sortname, final]%
      \step[fieldsource=shortauthor]%
      \step[fieldset=sortname, origfieldval]%
    }%
    % trabalho acadêmico: ano da defesa (ver "Trabalho acadêmico", abaixo)
    \map[overwrite=false]{%
      \pertype{thesis}%
      \step[fieldsource=date, match=\regexp{\A(\d{4})}, final]%
      \step[fieldset=eventdate, fieldvalue={$1}]%
    }%
    \map[overwrite=false]{%
      \pertype{thesis}%
      \step[fieldsource=year, match=\regexp{\A(\d{4})\Z}, final]%
      \step[fieldset=eventdate, fieldvalue={$1}]%
    }%
  }%
}

\newbibmacro*{crpsp:sigla}{%
  \iffieldundef{crpspsigla}{}{%
    \printnames{shortauthor}%
    \setunit{\addspace\textemdash\addspace}%
  }%
}

\xpatchbibmacro{author}
  {\printnames{author}}
  {\usebibmacro{crpsp:sigla}\printnames{author}}
  {}
  {\PackageWarning{crpsp-abnt}{Nao consegui acrescentar a sigla ao autor}}

% <<<1

% Strings >>>1

\NewBibliographyString{crpspbyorganizer}
\DefineBibliographyStrings{brazilian}{crpspbyorganizer = {organizado por}}
\DefineBibliographyStrings{portuguese}{crpspbyorganizer = {organizado por}}
\DefineBibliographyStrings{english}{crpspbyorganizer = {organized by}}

% <<<1

% Legislação e ato normativo (6023, 7.11.1, 7.11.2, 7.11.5, 7.11.6) >>>1
%
% O upstream manda @legislation, @legal e @jurisdiction para o driver de
% @article (abnt.bbx, DeclareBibliographyAlias): sem publicação oficial, sai
% "local, editora" em vez de "local: editora", e edição, organizador e "In:"
% somem. Aqui @legislation e @legal ganham um driver próprio, o mesmo para os
% dois: a diferença entre 7.11.1 e 7.11.5 está nos dados (a entrada é a
% jurisdição ou a entidade), não na ordem dos elementos.
%
% Ordem: autoria. título. ementa. edição. organizador. In: obra.
% publicação oficial ou local: editora, data. páginas. notas. complementos.
% DOI e acesso online.
%
% @jurisdiction continua no alias do upstream até o Sprint 5.

\DeclareFieldFormat{ementa}{#1\isdot}
\DeclareFieldFormat{complementos}{#1\isdot}

% Organizador de coletânea de leis: "Organizado por Fulano" (7.11.1, ex. 2),
% não "Organização: Fulano", que é o que o upstream imprime.
\newbibmacro*{crpsp:byeditor}{%
  \ifboolexpr{%
    not test {\ifnameundef{editor}}%
    and%
    test {\iffieldequalstr{editortype}{organizer}}%
  }{%
    \bibstring{crpspbyorganizer}%
    \setunit*{\addspace}%
    \printnames[byeditor]{editor}%
    \clearname{editor}%
    \newunit%
  }{%
    \usebibmacro{byeditor+others}%
  }%
}

% Ato publicado dentro de outra obra: "In: VADE mecum." (7.11.2, ex. 3)
\newbibmacro*{crpsp:in}{%
  \ifboolexpr{%
    test {\iffieldundef{booktitle}}%
    and%
    test {\iffieldundef{maintitle}}%
  }{}{%
    \usebibmacro{in:}%
    \usebibmacro{maintitle/booktitle}%
  }%
}

% Publicação: no diário oficial, a sequência do driver de @article, que o
% upstream já acerta (7.11.1, ex. 3); fora dele, "local: editora, data".
\newbibmacro*{crpsp:publicacao}{%
  \iffieldundef{journaltitle}{%
    \usebibmacro{publisher+location+date}%
  }{%
    \usebibmacro{journal+section}%
    \setunit*{\addcomma\addspace}%
    \printlist{publisher}%
    \setunit*{\addcomma\addspace}%
    \printlist{location}%
    \setunit*{\addcomma\addspace}%
    \usebibmacro{volume+number+eid}%
    \setunit{\addcomma\addspace}%
    \printfield{pages}%
    \setunit{\addcomma\addspace}%
    \usebibmacro{issue+date}%
  }%
}

\DeclareBibliographyDriver{legislation}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/organization}%
  \setunit{\labelnamepunct}%
  \usebibmacro{title}%
  \newunit\newblock
  \printfield{ementa}%
  \newunit\newblock
  \usebibmacro{crpsp:byeditor}%
  \newunit\newblock
  \printfield{edition}%
  \newunit\newblock
  \usebibmacro{crpsp:in}%
  \newunit\newblock
  \usebibmacro{crpsp:publicacao}%
  \newunit\newblock
  \printfield{pagetotal}%
  \newunit\newblock
  \printfield{note}%
  \newunit\newblock
  \printfield{complementos}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}%
    {\usebibmacro{related:init}%
     \usebibmacro{related}}%
    {}%
  \usebibmacro{finentry}%
}

\DeclareBibliographyAlias{legal}{legislation}

% <<<1

% Data da chamada >>>1
%
% O biblatex, na falta de data, toma a data de acesso para a chamada: a página
% sem data saía "(Deaf Services Unlimited, 2026)", com a referência sem ano.
% O acesso não é data do documento. Sem data, a chamada sai com "s.d." e o
% estilo avisa: a 6023 pede um ano entre colchetes, provável ou aproximado
% (8.6.1.3), e ele vai no .bib, em year = {[2020?]}.
\DeclareLabeldate{%
  \field{date}%
  \field{year}%
  \field{eventdate}%
  \field{origdate}%
  \literal{nodate}%
}
\AtDataInput{%
  \iffieldequalstr{labeldatesource}{nodate}
    {\PackageWarning{crpsp-abnt}{%
       '\thefield{entrykey}' nao tem data. A NBR 6023 pede\MessageBreak
       um ano entre colchetes (8.6.1.3): year = {[2020?]}}}
    {}%
}

% <<<1

% Trabalho acadêmico (6023, 7.1.2) >>>1
%
% "2009. Tese (Doutorado em Cardiologia) – Faculdade de Medicina, Universidade
% de São Paulo, São Paulo, 2009.": o ano volta no fim, como data da defesa. O
% driver do upstream imprime ali o eventdate, que quase nenhum .bib traz. Sem
% ele, o mapa copia o ano de date ou de year (o mapa está junto com o da
% sigla, em "Sigla como entrada": um segundo \DeclareStyleSourcemap apagaria
% o primeiro).

% <<<1

% Documento online (6023, 7.2.2 e 8.4-8.6) >>>1
%
% O driver de @online vem do standard.bbx, que ignora location e publisher:
% "Holding inclusive events. [2016?]." em vez de "Washington, DC: ASAN,
% [2016?].". Aqui a publicação entra antes da data, com organization no
% lugar da editora quando não há publisher. Só sai o que estiver no .bib: o
% [S. l.] em documento online, em que a 6023:2025 se contradiz, fica para o
% Sprint 4 (briefing, 2.5).
%
% A lista vazia não é chamada: um \printlist sem resultado impede o \setunit*
% seguinte de trocar a pontuação, e saía "Brussels: 31 out. 2024.".
\newbibmacro*{crpsp:online:publicacao}{%
  \printlist{location}%
  \iflistundef{publisher}
    {\iflistundef{organization}
       {}
       {\setunit*{\addcolon\addspace}\printlist{organization}}}
    {\setunit*{\addcolon\addspace}\printlist{publisher}}%
  \setunit*{\addcomma\addspace}%
  \usebibmacro{date}%
}

\DeclareBibliographyDriver{online}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{author/editor+others/translator+others}%
  \setunit{\labelnamepunct}\newblock
  \usebibmacro{title}%
  \newunit
  \printlist{language}%
  \newunit\newblock
  \usebibmacro{byauthor}%
  \newunit\newblock
  \usebibmacro{byeditor+others}%
  \newunit\newblock
  \printfield{version}%
  \newunit
  \printfield{note}%
  \newunit\newblock
  \usebibmacro{crpsp:online:publicacao}%
  \newunit\newblock
  \usebibmacro{doi+eprint+url}%
  \newunit\newblock
  \usebibmacro{addendum+pubstate}%
  \setunit{\bibpagerefpunct}\newblock
  \usebibmacro{pageref}%
  \newunit\newblock
  \iftoggle{bbx:related}
    {\usebibmacro{related:init}%
     \usebibmacro{related}}
    {}%
  \usebibmacro{finentry}%
}

% <<<1

\endinput
