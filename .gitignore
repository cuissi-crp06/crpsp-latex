# PDFs de formularios/ deixam de ser versionados — gerar sob demanda a partir do .tex
formularios/**/*.pdf

# New June é proprietária: vem do Nextcloud (editorial/fonts/NewJune), não do git.
# Ver crpsp-book/desenvolvimento/docker/README.md.
NEWJUNE*.[oO][tT][fF]
NewJune*.[oO][tT][fF]

# Conteúdo de publicação fica no Nextcloud, não aqui.
publicacoes/
