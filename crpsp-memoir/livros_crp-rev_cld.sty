% ===================================================================
% livros_crp.sty — Pacote editorial do CRP-SP
% Motor: LuaLaTeX + classe memoir
%
% Estrutura:
%   1. Tipografia
%   2. Cores & gráficos
%   3. Tabelas
%   4. Diagramação & layout
%   5. Navegação & PDF
%   6. Revisão de texto
%   7. Comandos e ambientes institucionais
% ===================================================================


% ===================================================================
% 1. TIPOGRAFIA
% ===================================================================

% [no-math]: evita conflito com pacotes matemáticos.
\usepackage[no-math]{fontspec}

% --- Fonte principal (serifada) ---
% Lora em TTF, carregada do diretório do documento (Path=./).
\setmainfont{Lora}[
    Path           = ./,
    Extension      = .ttf,
    UprightFont    = Lora-Regular,
    BoldFont       = Lora-Bold,
    ItalicFont     = Lora-Italic,
    BoldItalicFont = Lora-BoldItalic,
]

% --- Família sem serifa principal (NEWJUNE Regular) ---
% Usada em títulos de seção e elementos de destaque via \sffamily.
\setsansfont{NEWJUNE}[
    UprightFont    = NEWJUNE-REGULAR.OTF,
    BoldFont       = NEWJUNE-BOLD.OTF,
    ItalicFont     = NEWJUNE-REGULAR-ITALIC.OTF,
    BoldItalicFont = NEWJUNE-BOLD-ITALIC.OTF,
]

% --- Pesos adicionais NEWJUNE como famílias independentes ---
% Convenção: \<nome> ativa o peso; itálico disponível via \itshape.
% Nota: \serifada aponta para NEWJUNE-REGULAR — o nome é semântico
%       no contexto do projeto, não tipográfico.
\newfontfamily{\media}   {NEWJUNE-Medium}   [UprightFont=NEWJUNE-MEDIUM.OTF,    ItalicFont=NEWJUNE-MEDIUM-ITALIC.OTF]
\newfontfamily{\fininha} {NEWJUNE-Fine}     [UprightFont=NEWJUNE-FINE.OTF,      ItalicFont=NEWJUNE-FINE-ITALIC.OTF]
\newfontfamily{\Light}   {NEWJUNE-Light}    [UprightFont=NEWJUNE-LIGHT.OTF,     ItalicFont=NEWJUNE-LIGHT-ITALIC.OTF]
\newfontfamily{\fontebook}{NEWJUNE-Book}    [UprightFont=NEWJUNE-BOOK.OTF,      ItalicFont=NEWJUNE-BOOK-ITALIC.OTF]
\newfontfamily{\serifada}{NEWJUNE-Serif}    [UprightFont=NEWJUNE-REGULAR.OTF,   ItalicFont=NEWJUNE-REGULAR-ITALIC.OTF]
\newfontfamily{\pesada}  {NEWJUNE-Ultrabold}[UprightFont=NEWJUNE-ULTRABOLD.OTF, ItalicFont=NEWJUNE-ULTRABOLD-ITALIC.OTF]

% --- Microtipografia ---
% No LuaLaTeX, protrusion e expansion estão ambos disponíveis.
% (No XeLaTeX apenas protrusion funcionava — razão da migração.)
\usepackage[
    protrusion = true,
    expansion  = true,
]{microtype}

% --- Hifenização ---
\usepackage{hyphenat}
% \hyph: hífen sem penalidade de quebra — para compostos longes
%        onde a quebra após o hífen é desejável.
\def\hyph{-\penalty0\hskip0pt\relax}

% --- Reticências ---
% oldmla: reticências entre colchetes [ . . . ] para omissões,
%         conforme o estilo MLA anterior à edição de 2009.
\usepackage[oldmla]{xellipsis}

% Espaçamento francês: sem espaço extra após ponto final.
\frenchspacing


% ===================================================================
% 2. CORES & GRÁFICOS
% ===================================================================

% dvipsnames: ativa nomes clássicos (ex.: MidnightBlue, BrickRed).
% Deve ser carregado antes de qualquer pacote que use xcolor
% internamente (tcolorbox, hyperref etc.).
\usepackage[dvipsnames]{xcolor}

% --- Paleta institucional CRP-SP ---
\definecolor{crp1}{RGB}{66,  44,  115}   % Púrpura escuro — headings, réguas, URLs
\definecolor{crp2}{RGB}{165, 93,  166}   % Púrpura médio — numeração de seções
\definecolor{crp3}{RGB}{191, 115, 171}   % Púrpura claro — uso decorativo

\usepackage{graphicx}
\usepackage{svg}
\usepackage{background}

% --- tcolorbox: carga única com todas as bibliotecas necessárias ---
% CORRIGIDO: o pacote era carregado duas vezes (sem opções na linha 63,
% com [skins,breakable] na linha 203). LaTeX aceita silenciosamente,
% mas apenas as opções da primeira carga são efetivas — as da segunda
% são ignoradas, o que tornava skins e breakable inoperantes.
\usepackage[skins, breakable]{tcolorbox}

% fboxsep=0pt: remove padding interno do \fbox.
% ATENÇÃO: afeta todos os \fbox do documento. Valor global deliberado.
\setlength{\fboxsep}{0pt}


% ===================================================================
% 3. TABELAS
% ===================================================================

\usepackage{array}
\usepackage{multirow}
\usepackage{longtable}
\usepackage{tabularx}
\usepackage{booktabs}
\usepackage{enumitem}

% Coluna P{<larg>}: parágrafo centralizado (extensão de array).
\newcolumntype{P}[1]{>{\centering\arraybackslash}p{#1}}

% Centralização vertical em colunas X do tabularx.
\renewcommand{\tabularxcolumn}[1]{m{#1}}

% Espaçamento entre linhas de tabelas: 20% acima do padrão.
\renewcommand{\arraystretch}{1.2}


% ===================================================================
% 4. DIAGRAMAÇÃO & LAYOUT
% ===================================================================

\usepackage{multicol}
\usepackage{pdfpages}
\usepackage{ragged2e}
\usepackage{calc}
\usepackage{lastpage}

% --- Colofão ---
% title={}: suprime o título padrão "Colophon".
\usepackage[title={}]{colophon}

% --- Sumário ---
\usepackage{tocvsec2}

% --- Dimensões da página ---
% \semiisopage: proporção áurea entre margens (memoir).
% As linhas \setstocksize / \settrims / \trimXmarks estão comentadas
% — mantidas como referência para produção com marcas de corte.
%\setstocksize{230mm}{168.5mm}
%\settrims{10mm}{10mm}
%\trimXmarks
\semiisopage

% --- Penalidades tipográficas ---
% Controlam linhas viúvas, órfãs e quebras indesejadas.
\clubpenalty        = 9996   % órfãs (primeira linha de parágrafo isolada)
\widowpenalty       = 9999   % viúvas (última linha isolada)
\brokenpenalty      = 4991   % linhas hifenizadas no final de página
\predisplaypenalty  = 10000  % evita quebra antes de display math
\postdisplaypenalty = 1549   % flexibiliza quebra após display math
\displaywidowpenalty= 1602   % viúva após display math

% --- Parskip e layout ---
% \nonzeroparskip e \sloppybottom são declarados ANTES de
% \checkandfixthelayout para que memoir os incorpore ao cálculo.
% CORRIGIDO: havia duas chamadas a \checkandfixthelayout (linhas 90
% e 93) com \nonzeroparskip e \sloppybottom entre elas — o que
% forçava um recálculo desnecessário. Uma única chamada ao final
% é suficiente.
\nonzeroparskip
\sloppybottom
\checkandfixthelayout

% --- Espaçamento entre linhas ---
% \setasuspacing: indireção que permite trocar o espaçamento global
% via \setasuspacing{\SingleSpacing} ou \setasuspacing{\OnehalfSpacing}.
% O padrão do documento é 1,5 linhas.
\newcommand*{\setasuspacing}[1]{%
    \let\AsuSpacing#1%
    \AsuSpacing}
\setasuspacing{\OnehalfSpacing}

% --- Lengths calculadas em tempo de compilação ---
% CORRIGIDO: movidas para \AtBeginDocument para garantir que
% as fontes e o layout estejam totalmente inicializados antes
% do cálculo de \widthof. Se calculadas no preâmbulo, uma
% mudança de fonte ou de \textwidth pode deixar os valores errados.
\newlength{\boxlarg}
\newlength{\virgula}
\newlength{\boxementa}
\newlength{\indicartigo}
\newlength{\paragrafodelei}
\newlength{\paragrafounico}
\newlength{\sepcredito}
\newlength{\numfrances}
\newlength{\numfrancesdois}
\newlength{\TOCVSpace}

\AtBeginDocument{%
    \setlength{\boxlarg}      {2em}%
    \setlength{\virgula}      {0.5em}%
    \setlength{\boxementa}    {\textwidth-6cm}%
    \setlength{\indicartigo}  {\widthof{\bfseries Art. 99º}}%
    \setlength{\paragrafodelei}{\widthof{\bfseries § 999º\space}}%
    \setlength{\paragrafounico}{\widthof{\bfseries Parágrafo único.\space}}%
    \setlength{\sepcredito}   {\widthof{\bfseries | }}%
    \setlength{\numfrances}   {\widthof{10\space\space}}%
    \setlength{\numfrancesdois}{\widthof{10\space}}%
    \setlength{\TOCVSpace}    {3\baselineskip}%
}

% --- Sumário ---
\setsecnumdepth{none}
\maxsecnumdepth{none}
\setcounter{tocdepth}{0}
\renewcommand{\aftertoctitle}{\vspace*{\TOCVSpace}}
\renewcommand*{\sectionmark}[1]{\markright{#1}}

% --- Page styles ---

% pretext: frontmatter e páginas de parte — sem cabeçalho/rodapé.
\makepagestyle{pretext}
\makeoddhead {pretext}{}{}{}
\makeoddfoot {pretext}{}{}{}
\makeevenhead{pretext}{}{}{}
\makeevenfoot{pretext}{}{}{}
\aliaspagestyle{part}{pretext}

% crp: miolo principal — régua e número de página em crp1.
\copypagestyle{crp}{headings}
\makeheadfootruleprefix{crp}{\color{crp1}}{\color{crp1}}
\makeheadrule         {crp}{\textwidth}{\normalrulethickness}
\makeevenhead{crp}{\color{crp1}\Light\small\thepage}  {}{\color{crp1}\Light\small\leftmark}
\makeoddhead {crp}{\color{crp1}\Light\small\rightmark}{}{\color{crp1}\Light\small\thepage}

% crpPre: miolo com fonte book (variante de crp para pré-textuais).
% CORRIGIDO: as linhas de \makeheadfootruleprefix e \makeheadrule
% referenciavam o estilo "crp" em vez de "crpPre" — as regras de
% crpPre sobrescreviam as de crp silenciosamente.
\copypagestyle{crpPre}{headings}
\makeheadfootruleprefix{crpPre}{\color{crp1}}{\color{crp1}}
\makeheadrule         {crpPre}{\textwidth}{\normalrulethickness}
\makeevenhead{crpPre}{\color{crp1}\fontebook\small\thepage}         {}{\color{crp1}\fontebook\small\itshape\leftmark}
\makeoddhead {crpPre}{\color{crp1}\fontebook\small\itshape\rightmark}{}{\color{crp1}\fontebook\small\thepage}

% chapter: página de abertura de capítulo — limpa (sem cabeçalho).
% Derivado de pretext para garantir herança correta.
\copypagestyle{chapter}{pretext}

% --- Numeração de seções em margem (hangsecnum) ---
% \makeatletter necessário porque \@seccntformat usa @ no nome.
% Isolado em bloco próprio para clareza.
\makeatletter
\renewcommand{\hangsecnum}{%
    \def\@seccntformat##1{%
        \makebox[0pt][r]{%
            \color{crp2}%
            \csname the##1\endcsname
            \quad
        }%
    }%
}
\makeatother

% --- Estilos de seção ---
% Skip pós-título: proporção áurea (0.618) de \baselineskip.
\setsecheadstyle      {\color{crp1}\sffamily\Large\bfseries}
\setaftersecskip      {0.618\baselineskip}
\setsubsecheadstyle   {\color{crp1}\sffamily\normalsize\bfseries}
\setaftersubsecskip   {0.618\baselineskip}
\setsubsubsecheadstyle{\color{crp1}\sffamily\normalsize\itshape}
\setaftersubsubsecskip{0.618\baselineskip}
\setparaheadstyle     {\color{crp1}\sffamily\normalsize\bfseries}
\setafterparaskip     {0.618\baselineskip}
% CORRIGIDO: \setsubparaheadstyle usava \color sem argumento —
% provavelmente erro de edição (faltava \color{crp1} ou similar).
% Definido com \color{crp1} para coerência com os demais níveis.
\setsubparaheadstyle  {\color{crp1}\sffamily\normalsize}
\setaftersubparaskip  {0.618\baselineskip}

% --- Partes ---
\renewcommand{\printparttitle}{\flushright\HUGE\bfseries\color{crp1}\thepart}
\renewcommand{\beforepartskip}{\vspace*{\fill}}
\renewcommand{\afterpartskip} {\vspace*{4\baselineskip}}
\let\partold\part
\RenewDocumentCommand{\part}{O{#2} m}{%
    \partold[#1]{\MakeUppercase{#2}}%
}

% --- Capítulos ---
\nouppercaseheads
\makechapterstyle{CRP01}{%
    \renewcommand{\chaptitlefont}{\huge\bfseries\sffamily\color{crp2}}%
    \setlength{\afterchapskip}{8\baselineskip}%
}
\chapterstyle{CRP01}


% ===================================================================
% 5. NAVEGAÇÃO & PDF
