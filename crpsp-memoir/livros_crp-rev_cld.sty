% xurl antes de hyperref — estende as regras de quebra de URL.
\usepackage[obeyspaces, spaces, hyphens, urlbreaks]{xurl}
\usepackage{hyperref}
\hypersetup{
    colorlinks = true,
    linkcolor  = black,
    filecolor  = black,
    urlcolor   = crp1,
}
\urlstyle{same}


% ===================================================================
% 6. REVISÃO DE TEXTO
% ===================================================================

\usepackage{changes}
% Autor registrado: Angelo Cuissi (id: cuissi).
% \sethighlightmarkup{\footnotesize}: highlights aparecem em corpo
% reduzido — comportamento não-padrão, preservado intencionalmente.
\definechangesauthor[name={Angelo Cuissi}]{cuissi}
\sethighlightmarkup{\footnotesize}


% ===================================================================
% 7. COMANDOS E AMBIENTES INSTITUCIONAIS
% ===================================================================
%
% Convenções adotadas nesta seção:
%   - Toda macro que altera cor ou fonte restaura ao final.
%   - Toda macro que altera espaçamento chama \setasuspacing
%     ou restaura via \normalfont conforme o contexto.
%   - \noindent é explícito quando necessário; nunca implícito.

% --- Subtítulo de abertura ---
% Posicionado com vspace negativo para sobrepor o espaço de capítulo.
\newcommand{\SubTituloUm}[1]{%
    \vspace{-8\baselineskip}%
    \noindent\raggedright\large\itshape #1\par
    \normalfont\normalsize\color{black}\justifying
    \vspace{8\baselineskip}%
}

% --- Intertítulo ---
\newcommand{\Entretitulo}[1]{%
    \vspace{0.618\baselineskip}%
    \noindent\color{crp1}\Light #1\par
    \vspace{0.382\baselineskip}%
    \normalfont\normalsize\color{black}%
}

% --- Filete decorativo ---
\newcommand{\setetoques}{\rule{6em}{0.4pt}}

% --- Identificadores de plenário ---
\newcommand{\xviplenario} {\textbf{XVI Plenário}}
\newcommand{\xviiplenario}{\textbf{XVII Plenário}}

% --- Bloco de assinatura institucional ---
\newcommand{\assinaapresenta}[1]{%
    \begin{flushright}
        \noindent
        Conselho Regional de Psicologia de São Paulo\\
        #1%
    \end{flushright}
    \justifying
    \setasuspacing{\OnehalfSpacing}%
}

% --- Assinatura centrada (nome + cargo) ---
\newcommand{\LegAssina}[2]{%
    \begin{center}
        #1\\
        #2
    \end{center}
}

% --- Título centrado em negrito ---
\newcommand{\LegTitulo}[1]{%
    \begin{center}
        \textbf{#1}
    \end{center}
}

% --- Ementa de legislação ---
% Offset de 6cm à esquerda; texto em sffamily footnotesize.
\newcommand{\LegEmenta}[1]{%
    \noindent
    \begin{minipage}{6cm}\hfill\end{minipage}%
    \begin{minipage}{\boxementa}%
        \justifying\sffamily\footnotesize\noindent #1%
    \end{minipage}\par
}

% --- Artigo de lei ---
% Recuo baseado em \indicartigo (calculado em \AtBeginDocument).
\newcommand{\LegArtigo}[2]{%
    \begin{description}[
        align      = left,
        leftmargin = !,
        labelwidth = \indicartigo,
        labelsep   = 1em,
    ]
        \item[Art.\,#1\,] #2%
    \end{description}
}

% --- Parágrafo de lei (numerado ou único) ---
% CORRIGIDO: \LegParagrafo e \LegParagrafoUnico eram idênticos no
% código — diferiam apenas na indentação do fonte. Unificados em
% um único comando. O argumento #1 recebe o label completo
% (ex.: "§ 1º" ou "Parágrafo único.").
\newcommand{\LegParagrafo}[2]{%
    \noindent
    \begin{minipage}{\indicartigo-0.5em}\hfill\end{minipage}%
    \begin{minipage}{\linewidth-1.5\indicartigo+1em}%
        \textbf{#1} #2%
    \end{minipage}\par
}

% \LegParagrafoUnico: alias semântico para clareza nos documentos.
\let\LegParagrafoUnico\LegParagrafo

% --- Caso (abertura de caso clínico/ético) ---
\newcommand{\Caso}[1]{%
    \clearpage
    \begin{center}
        \color{crp1}\sffamily\textbf{#1}%
    \end{center}
}

% --- Ambientes de bloco sem recuo ---
\newenvironment{blocao}
    {\setlength{\parindent}{0pt}}
    {}

\newenvironment{blocaosingle}
    {\setlength{\parindent}{0pt}\setasuspacing{\SingleSpacing}}
    {\setasuspacing{\OnehalfSpacing}}

% ---------------------------------------------------------------
% Páginas de créditos
% ---------------------------------------------------------------

% Ambiente base: scriptsize, SingleSpacing, raggedright.
% CreditoInstitucional e CreditoInstitucionalDestaque compartilham
% a mesma estrutura — a distinção entre eles é semântica (uso nos
% documentos). Unificados internamente; manter os dois nomes
% preserva a interface existente.
\newenvironment{CreditoInstitucional}{%
    \raggedright\noindent\scriptsize
    \setasuspacing{\SingleSpacing}%
}{}

% CORRIGIDO: CreditoInstitucionalDestaque era idêntico a
% CreditoInstitucional mas com um \vspace comentado no fechamento.
% Unificado; o alias preserva compatibilidade com documentos existentes.
\let\CreditoInstitucionalDestaque\CreditoInstitucional
\let\endCreditoInstitucionalDestaque\endCreditoInstitucional

% Cabeçalho de seção de créditos (nível 1): normalsize, negrito, crp1.
\newcommand{\CreditoInstitucionalUm}[1]{%
    \raggedright
    {\sffamily\normalsize\bfseries\color{crp1}#1}\par
    \vspace{-0.382\baselineskip}%
}

% Cabeçalho de seção de créditos (nível 2): footnotesize, negrito, crp1.
% Uso: subseções dentro de uma seção de créditos.
\newcommand{\CreditoInstitucionalDois}[1]{%
    \raggedright
    \vspace{0.2\baselineskip}%
    {\sffamily\footnotesize\bfseries\color{crp1}#1}\par
    \vspace{-1.382\baselineskip}%
}

% Linha de crédito técnico: label (30%) + valor (61.8%).
\newcommand{\CreditoTecnico}[2]{%
    \begin{CreditoInstitucional}
        \vspace{-1.618\baselineskip}%
        \setlength{\tabcolsep}{0pt}%
        \begin{tabular}{p{0.3\linewidth} p{0.618\linewidth}}
            \sffamily\scriptsize\bfseries\color{crp1}#1 &
            \normalfont\color{black}#2 \\
        \end{tabular}%
        \vspace{-1\baselineskip}%
    \end{CreditoInstitucional}
}

% Lista de cargos: duas colunas (60% + 40%), fonte book.
\newcommand{\CargoNosCreditos}[1]{%
    \sffamily\scriptsize\raggedright
    \setlength{\tabcolsep}{0pt}%
    \begin{tabular}{p{0.6\linewidth} p{0.4\linewidth}}
        \fontebook #1
    \end{tabular}%
    \vspace{-0.618\baselineskip}%
}

% Lista de nomes: coluna única, fonte book.
\newcommand{\NomeNosCreditos}[1]{%
    \sffamily\scriptsize\raggedright
    \setlength{\tabcolsep}{0pt}%
    \begin{tabular}{p{\linewidth}}
        \fontebook #1
    \end{tabular}%
}
