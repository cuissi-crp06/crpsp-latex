% --- Page styles via fancyhdr ---
\usepackage{fancyhdr}

% Espessura da régua de cabeçalho. No memoir, \normalrulethickness
% valia 0.4pt; aqui fixamos o mesmo valor como length própria para
% manter a identidade visual do pacote original.
\newlength{\crpheadrulewidth}
\setlength{\crpheadrulewidth}{0.4pt}

% Estilo "crp" (miolo principal): régua + número de página + mark.
% Cor crp1 aplicada via \color no conteúdo do cabeçalho.
% NOTA: fancyhdr não tem equivalente direto ao \makeheadfootruleprefix
% do memoir (que colore a régua independentemente do texto). Aqui
% redefinimos \headrule para incluir \color{crp1}.
\fancypagestyle{crp}{%
    \fancyhf{}%
    \fancyhead[LE]{\color{crp1}\Light\small\thepage}%
    \fancyhead[RE]{\color{crp1}\Light\small\leftmark}%
    \fancyhead[LO]{\color{crp1}\Light\small\rightmark}%
    \fancyhead[RO]{\color{crp1}\Light\small\thepage}%
    \renewcommand{\headrule}{%
        {\color{crp1}\hrule width\headwidth height\crpheadrulewidth}%
    }%
    \renewcommand{\footrulewidth}{0pt}%
}

% Estilo "crpPre" (pré-textuais com fonte book em itálico)
\fancypagestyle{crpPre}{%
    \fancyhf{}%
    \fancyhead[LE]{\color{crp1}\fontebook\small\thepage}%
    \fancyhead[RE]{\color{crp1}\fontebook\small\itshape\leftmark}%
    \fancyhead[LO]{\color{crp1}\fontebook\small\itshape\rightmark}%
    \fancyhead[RO]{\color{crp1}\fontebook\small\thepage}%
    \renewcommand{\headrule}{%
        {\color{crp1}\hrule width\headwidth height\crpheadrulewidth}%
    }%
    \renewcommand{\footrulewidth}{0pt}%
}

% Estilo "pretext": folha de rosto e partes — sem cabeçalho.
\fancypagestyle{pretext}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
}

% O estilo `plain` (usado automaticamente em páginas de abertura
% de capítulo) é redefinido para também ficar limpo:
\fancypagestyle{plain}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
}

% Marks para o cabeçalho: capítulo em \leftmark, seção em \rightmark.
% book já faz isso por padrão; aqui garantimos que o formato não
% aplique \MakeUppercase (que seria ruim para leitores de tela).
\renewcommand{\chaptermark}[1]{\markboth{\scriptsize\itshape #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\scriptsize\itshape #1}}
\makeatletter
    % --- Estilos de título — redefinições manuais (sem titlesec) ---
%
% Motivação: titlesec é INCOMPATÍVEL com latex-lab phase-III tagging.
% Causa descasamento begin/end de paragraph hooks:
%   "number of automatic begin (N) and end (N-1) text-unit para hooks differ"
% Solução: redefinir diretamente os comandos internos do book.cls
% (\@makechapterhead, \@startsection etc.), que são compatíveis com
% o mecanismo de tagging do latex-lab.
%
% Validado com mwe_sty_manual.tex + lualatex-dev em 2026-04-09:
% zero erros, zero warnings de open structures, árvore de tags limpa
% (<Sect> → <H1>/<H2>/<H3> na hierarquia correta).

% --- Títulos de capítulo via sec-template ---
%
% Motivação: o latex-lab phase-III (carregado via \DocumentMetadata)
% ativa latex-lab-testphase-sec-template.sty, que declara a instância
% 'chapter' do tipo heading/display via \AddToHook{class/book/after}.
% Esse hook roda ANTES do \usepackage{livros_crp_acessivel_book}, de
% modo que \chapter passa a usar \UseInstance{heading}{chapter} e
% NUNCA chama \@makechapterhead. Redefinir \@makechapterhead aqui é
% letra morta.
%
% Solução: redeclarar a instância 'chapter' com a identidade visual
% CRP-SP usando \AddToHook{class/book/after} com label próprio.
% Nota: mark-cmd usa #1 (não ##1) — dentro de \AddToHook não há
% dobramento de parâmetro, ao contrário de \newcommand/\def.
%
% Por que \color{crp2} em title-decls e não em decls?
% O headformat/display (sec-template v0.9b, linha ~450) executa:
%   \normalfont \normalcolor        ← reseta cor para preto
%   \l__head_decls_tl{}             ← decls roda APÓS normalcolor
%   \l__head_number_decls_tl        ← number-decls
%   \l__head_title_decls_tl         ← title-decls: último a rodar
%   {#3}                            ← texto do título
% \color{crp2} em decls seria resetado pelo \normalcolor da próxima
% invocação; colocar em title-decls (e number-decls) garante que a
% cor está ativa no momento em que o texto é composto.
%
% Validado contra latex-lab-testphase-sec-template.sty v0.9b
% (2026-01-26), MiKTeX 26.2, lualatex-dev 2026-04-14.
%
% [2026-08-04] O upstream RENOMEOU as chaves do template heading/
% display. Na v0.9g (2026-05-25, TeX Live 2026 / imagem podman) o
% bloco escrito para a v0.9b falha com 4 erros por capítulo:
%
%   ! LaTeX template Error: Unknown template key 'after-penalty-sep'.
%   ! LaTeX template Error: Unknown template key 'after-sep'.
%   ! LaTeX template Error: Unknown template key 'decls'.
%   ! LaTeX template Error: The instance 'display' of type
%                           'headformat' is unknown.
%
% Correspondência das chaves:
%   after-penalty-sep    → after-penalty-vspace
%   after-sep            → after-vspace
%   decls                → heading-decls
%   headformat-instance = display → = chapter
%
% Com a instância inválida a customização é ignorada por inteiro e
% os capítulos caem no formato padrão do latex-lab (preto, sem
% \sffamily) — falha silenciosa do ponto de vista visual.
%
% Os dois ramos abaixo existem porque a linha `book` tem dois
% motores: o podman (TL 2026, v0.9g) e o MiKTeX/Windows histórico,
% que pode ainda trazer a v0.9b. O limiar 2026/05/25 é a versão em
% que a renomeação foi OBSERVADA; as versões intermediárias
% (v0.9c–v0.9f) não foram testadas — se algum motor trouxer uma
% delas, verificar de que lado do limiar ela cai.
\AddToHook{class/book/after}[crp/chapter]{%
    \@ifpackagelater{latex-lab-testphase-sec-template}{2026/05/25}
        {\DeclareInstance{heading}{chapter}{display}
            {%
                , name                 = chapter
                , level                = 0
                , placement            = top
                , after-penalty-vspace = 50pt
                , after-vspace         = 40pt
                , number-format        = \@chapapp\space\thechapter
                , heading-decls        = \raggedright\parindent0pt\bfseries\sffamily
                , number-decls         = \huge\color{crp1}
                , title-decls          = \Huge\color{crp1}
                , headformat-instance  = chapter
                , mark-cmd             = \chaptermark {#1}
                , contents-extra       = \addtocontents{lof}{\protect\addvspace{10\p@}}%
                                         \addtocontents{lot}{\protect\addvspace{10\p@}}%
            }%
        }
        {\DeclareInstance{heading}{chapter}{display}
            {%
                , name               = chapter
                , level              = 0
                , placement          = top
                , after-penalty-sep  = 50pt
                , after-sep          = 40pt
                , number-format      = \@chapapp\space\thechapter
                , decls              = \raggedright\parindent0pt\bfseries\sffamily
                , number-decls       = \huge\color{crp1}
                , title-decls        = \Huge\color{crp1}
                , headformat-instance = display
                , mark-cmd           = \chaptermark {#1}
                , contents-extra     = \addtocontents{lof}{\protect\addvspace{10\p@}}%
                                       \addtocontents{lot}{\protect\addvspace{10\p@}}%
            }%
        }%
}

% \TOCAcessivel: substituto de \tableofcontents para contornar
% bug upstream de latex-lab-testphase-toc (testado com latex-lab-dev
% 2026-01-30). Em book + tagging=on, o \tableofcontents padrão
% emite a tag <H1> do título do sumário contendo macros não-
% expandidas (\contentsname, \protect, \markboth, \MakeUppercase),
% porque o mecanismo de tagging captura o título antes de \protect
% resolver a cadeia. Resultado na árvore de tags:
%
%     <H1> Sum\'ario\protect \markboth {\MakeUppercase []{Sum\'ari...
%
% que um leitor de tela leria como sequência incompreensível de
% barras e comandos.
%
% Workaround: passar a string literal "Sumário" via \chapter*,
% que não envolve \contentsname na cadeia de \protect. O
% \phantomsection + \addcontentsline são omitidos deliberadamente
% — o sumário não precisa aparecer em si mesmo, e sem eles
% evitamos adicionar uma entrada recursiva de TOC.
%
% [2026-08-04] BUG CORRIGIDO UPSTREAM. Com latex-lab-testphase-toc
% v0.85k (2026-04-28, TeX Live 2026), o \tableofcontents padrão
% emite o elemento de estrutura correto:
%
%     /Type /StructElem /T <FEFF00530075006D00E100720069006F>
%                                             → "Sumário"
%
% sem vestígio da cadeia \protect\markboth\MakeUppercase. Verificado
% em MWE e no guia_apresentacoes_acessiveis.tex completo (0 erros de
% tagging, 37 páginas).
%
% \TOCAcessivel fica como ALIAS DEPRECADO: nos motores novos delega
% para \tableofcontents; nos antigos (MiKTeX com o toc anterior a
% 2026-04-28) mantém o contorno original. Documentos novos devem
% chamar \tableofcontents direto.
\newcommand{\TOCAcessivelLegado}{%
    \chapter*{Sumário}%
    \@starttoc{toc}%
}
\newcommand{\TOCAcessivel}{%
    \@ifpackagelater{latex-lab-testphase-toc}{2026/04/28}
        {\tableofcontents}
        {\TOCAcessivelLegado}%
}

% \@makechapterhead e \@makeschapterhead mantidos como fallback para
% compilações SEM \DocumentMetadata (phase-III inativo), onde
% \chapter ainda delega para estes comandos.
\renewcommand\@makechapterhead[1]{%
    \vspace*{50\p@}%
    {\parindent \z@ \raggedright \normalfont
     \interlinepenalty\@M
     \huge\bfseries\sffamily\color{crp2}#1\par\nobreak
     \vskip 8\baselineskip
    }%
}

\renewcommand\@makeschapterhead[1]{%
    \vspace*{50\p@}%
    {\parindent \z@ \raggedright \normalfont
     \interlinepenalty\@M
     \huge\bfseries\sffamily\color{crp2}#1\par\nobreak
     \vskip 8\baselineskip
    }%
}

% --- Partes ---
% Redefinimos \part e os internos \@part / \@spart para aplicar
% a identidade visual CRP-SP, mantendo o comportamento de
% \cleardoublepage e \@endpart do book.cls.
% \MakeUppercase REMOVIDO: leitor de tela pronunciaria siglas
% letra-por-letra; escrever em caixa alta no .tex se necessário.
\renewcommand\part{%
    \if@openright\cleardoublepage\else\clearpage\fi
    \thispagestyle{plain}%
    \if@twocolumn\onecolumn\@tempswatrue\else\@tempswafalse\fi
    \null\vfil
    \secdef\@part\@spart}

\def\@part[#1]#2{%
    \ifnum \c@secnumdepth >-2\relax
        \refstepcounter{part}%
        \addcontentsline{toc}{part}{\thepart\hspace{1em}#2}%
    \else
        \addcontentsline{toc}{part}{#2}%
    \fi
    \markboth{}{}%
    {\centering
     \interlinepenalty \@M
     \normalfont
     \ifnum \c@secnumdepth >-2\relax
       \huge\bfseries\sffamily\color{crp1} \partname\nobreakspace\thepart
       \par
       \vskip 20\p@
     \fi
     \Huge \bfseries \sffamily \color{crp1} #2\par}%
    \@endpart}

\def\@spart#1{%
    {\centering
     \interlinepenalty \@M
     \normalfont
     \Huge \bfseries \sffamily \color{crp1} #1\par}%
    \@endpart}

% --- Seções via \@startsection ---
% Assinatura: {nome}{nível}{recuo}{skip-antes}{skip-depois}{estilo}
% skip-depois negativo = runin (parágrafo inline).
\renewcommand\section{%
    \@startsection{section}{1}{\z@}%
        {-2\baselineskip}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\Large\bfseries}}

\renewcommand\subsection{%
    \@startsection{subsection}{2}{\z@}%
        {-1.5\baselineskip}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\normalsize\bfseries}}

\renewcommand\subsubsection{%
    \@startsection{subsubsection}{3}{\z@}%
        {-\baselineskip}%
        {0.618\baselineskip}%
        {\color{crp1}\sffamily\normalsize\itshape}}

\renewcommand\paragraph{%
    \@startsection{paragraph}{4}{\z@}%
        {-0.5\baselineskip}%
        {-0.5em}%   % negativo: runin
        {\color{crp1}\sffamily\normalsize\bfseries}}

\renewcommand\subparagraph{%
    \@startsection{subparagraph}{5}{\parindent}%
        {-0.5\baselineskip}%
        {-0.5em}%
        {\color{crp1}\sffamily\normalsize}}
\makeatother
% ===================================================================
% 5. NAVEGAÇÃO & PDF
% ===================================================================

% xurl antes de hyperref — estende regras de quebra de URL.
% NOTA: a opção urlbreaks requer que url não tenha sido carregado
% antes. Com \DocumentMetadata ativo, pdfmanagement pode carregar
% url antecipadamente — por isso não usamos urlbreaks aqui.
\usepackage[obeyspaces, spaces, hyphens]{xurl}
\usepackage{hyperref}
% O nameref captura \@chapter antes de \@makechapterhead estar
% disponível. Corrigimos \NR@chapter e \NR@schapter no início
% do documento, quando tudo já foi carregado.
\makeatletter
\AtBeginDocument{%
    \let\NR@chapter\@chapter
    \let\NR@schapter\@schapter
}
\makeatother
% \DocumentMetadata já configura título, autor, idioma via XMP.
% hypersetup aqui cuida apenas da aparência dos links e de
% pdfdisplaydoctitle (exigido por PDF/UA).
\hypersetup{
    colorlinks         = true,
    linkcolor          = crp1,
    filecolor          = black,
    urlcolor           = crp1,
    pdfdisplaydoctitle = true,
    bookmarksopen      = true,
    bookmarksnumbered  = false,
}
\urlstyle{same}

