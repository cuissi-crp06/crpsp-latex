% Diretório deste .sty, capturado ANTES de qualquer \RequirePackage.
% \CurrentFilePath (ltfilehook, kernel 2020+) vale enquanto ESTE
% arquivo está sendo lido. Usado na seção 7 para carregar o módulo
% irmão crpsp-leg.sty mesmo quando o pacote é chamado por caminho
% relativo (\usepackage{../editorial/templates/…}) — os dois
% arquivos viajam juntos no deploy.
\edef\crp@sty@dir{\CurrentFilePath}
\ifx\crp@sty@dir\@empty\else
    \edef\crp@sty@dir{\crp@sty@dir/}%
\fi

% ===================================================================
% livros_crp_acessivel_book.sty — variante acessível, base `book`
% Motor:  LuaLaTeX + classe book (LaTeX standard)
% Alvo:   PDF/UA-2 (tagging automático via latex-lab / phase-III)
%
% Por que book e não scrbook?
%   Testes com o MWE mostraram que scrbook + latex-lab phase-III
%   produz árvore de tags estruturalmente incorreta: títulos de
%   capítulo e seção ficam como <P> dentro de <Part>, sem <H1>/<H2>.
%   O KOMA-Script emite warning explícito: "Activated tagging
%   detected but not supported". O mesmo teste com `book` puro
%   produziu <Sect> → <H1> título → <P> corretamente.
%
% Diferenças em relação a livros_crp.sty (memoir):
%   - Base book em vez de memoir
%   - Compatível com \DocumentMetadata + tagging=on
%   - Comandos memoir-only substituídos por titlesec + fancyhdr
%   - Layout via geometry com valores fixos reproduzindo \semiisopage
%   - background (2014, API legada) substituído por eso-pic
%   - Créditos institucionais refatorados (sem tabular de layout)
%   - changes removido (revisão editorial fora do pipeline de entrega)
%   - \MakeUppercase removido de \part (caixa real no fonte)
%
% PREREQUISITO no .tex principal (antes de \documentclass):
%   \DocumentMetadata{
%       lang        = pt-BR,
%       pdfstandard = ua-2,
%       pdfversion  = 2.0,
%       testphase   = {phase-III,table,firstaid},
%       tagging     = on,
%   }
%   \documentclass[11pt,a5paper,twoside,openright]{book}
%
% Estrutura:
%   1. Tipografia
%   2. Cores & gráficos
%   3. Tabelas
%   4. Diagramação & layout
%   5. Navegação & PDF
%   6. Revisão de texto        (bloco documental, sem código)
%   7. Comandos e ambientes institucionais
%      + camada Leg (módulo crpsp-leg.sty, carregado no fim da 7)
% ===================================================================


