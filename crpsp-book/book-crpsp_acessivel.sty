% O pacote `changes` foi removido desta variante. Motivos:
%   - Marcações de revisão (adicionado, removido, destaque) não
%     devem aparecer no PDF final de entrega; eram neutralizadas.
%   - Com phase-III + tagpdf ativos, `changes` colide com \comment
%     definido indiretamente por outros pacotes do pipeline.
%   - Revisão editorial é fluxo de produção, não de entrega: deve
%     ser feita em branch/versão separada, fora do pipeline PDF/UA.
%
% Se for necessário reintroduzir marcação de revisão em uma
% compilação de trabalho (nunca de entrega), carregar `changes`
% diretamente no .tex do documento — não aqui.


% ===================================================================
% 7. COMANDOS E AMBIENTES INSTITUCIONAIS
% ===================================================================
%
% Convenções adotadas nesta seção:
%   - Toda macro que altera cor ou fonte restaura ao final.
%   - Toda macro que altera espaçamento usa \setasuspacing
%     ou restaura via \normalfont conforme o contexto.
%   - \noindent é explícito quando necessário; nunca implícito.
%   - setspace (carregado na seção 4) usa \onehalfspacing /
%     \singlespacing (minúsculas) — NÃO as variantes memoir.

% --- Subtítulo de abertura ---
% \vspace negativo é intencional: sobrepõe o espaço pós-capítulo
% para posicionar o subtítulo imediatamente abaixo do título.
\newcommand{\SubTituloUm}[1]{%
    \vspace{-8\baselineskip}%
    \noindent\raggedright\large\itshape #1\par
    \normalfont\normalsize\color{black}\justifying
    \vspace{8\baselineskip}%
}

% --- Intertítulo ---
\newcommand{\Entretitulo}[1]{%
    \vspace{0.618\baselineskip}%
    \noindent\color{crp1}\Light #1\par
    \vspace{0.382\baselineskip}%
    \normalfont\normalsize\color{black}%
}

% --- Filete decorativo ---
\newcommand{\setetoques}{\rule{6em}{0.4pt}}

% --- Identificadores de plenário ---
\newcommand{\xviplenario} {\textbf{XVI Plenário}}
\newcommand{\xviiplenario}{\textbf{XVII Plenário}}

% --- Bloco de assinatura institucional ---
\newcommand{\assinaapresenta}[1]{%
    \begin{flushright}
        \noindent
        Conselho Regional de Psicologia de São Paulo\\
        #1%
    \end{flushright}
    \justifying
    \setasuspacing{\onehalfspacing}%
}

% --- Comandos Leg (legislação) ---
% MOVIDOS na v0.5.0 para o módulo crpsp-leg.sty (camada Leg completa:
% LegNorma, LegEpigrafe, LegAgrup, LegArtigo aninhável, incisos/
% alíneas/itens, remissões, notas de alteração…). Interface dos
% comandos históricos preservada (\LegArtigo, \LegParagrafo,
% \LegParagrafoUnico, \LegEmenta, \LegTitulo→deprecado, \LegAssina).
% Carga incondicional no fim desta seção.

% --- Caso (abertura de caso clínico/ético) ---
\newcommand{\Caso}[1]{%
    \clearpage
    \begin{center}
        \color{crp1}\sffamily\textbf{#1}%
    \end{center}
}

% --- Ambientes de bloco sem recuo ---
\newenvironment{blocao}
    {\setlength{\parindent}{0pt}}
    {}

\newenvironment{blocaosingle}
    {\setlength{\parindent}{0pt}\singlespacing}
    {\onehalfspacing}

% ---------------------------------------------------------------
% Páginas de créditos
% ---------------------------------------------------------------

% Ambiente base: scriptsize, singlespacing, raggedright.
\newenvironment{CreditoInstitucional}{%
    \setlength{\parskip}{0pt}%
    \singlespacing\sffamily\scriptsize\raggedright\noindent
}{}

% Alias semântico (interface existente preservada).
\let\CreditoInstitucionalDestaque\CreditoInstitucional
\let\endCreditoInstitucionalDestaque\endCreditoInstitucional

% Cabeçalho de seção de créditos (nível 1): normalsize, negrito, crp1.
\newcommand{\CreditoInstitucionalUm}[1]{%
    \raggedright
    {\sffamily\normalsize\bfseries\color{crp1}#1}\par
}

% Cabeçalho de seção de créditos (nível 2): footnotesize, negrito, crp1.
\newcommand{\CreditoInstitucionalDois}[1]{%
    \raggedright
    %\vspace{0.2\baselineskip}%
    {\sffamily\footnotesize\bfseries\color{crp1}#1}\par
    \vspace*{-1\baselineskip}%
}

% --- Linha de crédito técnico: label (30%) + valor (61.8%) ---
% REFATORADO: substituiu \begin{tabular}{p p} (proibido por PDF/UA)
% por \parbox duplo lado a lado.
% Interface preservada: \CreditoTecnico{label}{valor}
\newcommand{\CreditoTecnico}[2]{%
    \begin{CreditoInstitucional}
        \vspace{-1.618\baselineskip}%
        \noindent
        \parbox[t]{0.3\linewidth}{%
            \sffamily\scriptsize\bfseries\color{crp1}#1}%
        \parbox[t]{0.618\linewidth}{%
            \normalfont\color{black}#2}\par
        \vspace{-1\baselineskip}%
    \end{CreditoInstitucional}
}

% --- Lista de cargos: duas colunas (60% + 40%) ---
% REFATORADO: substituiu \begin{tabular}{p p} por \parbox duplo.
% MUDANÇA DE INTERFACE: agora requer dois argumentos separados
% (coluna esquerda e coluna direita) em vez de um bloco tabular.
% Documentos existentes que usavam \CargoNosCreditos{col1 & col2 \\}
% devem ser atualizados para \CargoNosCreditos{col1}{col2}.
\newcommand{\CargoNosCreditos}[2]{%
    \noindent
    \parbox[t]{0.6\linewidth}{\sffamily\scriptsize\raggedright #1}%
    \parbox[t]{0.4\linewidth}{\sffamily\scriptsize\raggedright #2}\par
    \vspace{0.3\baselineskip}%
}

% --- Lista de nomes: parágrafo único ---
% REFATORADO: substituiu \begin{tabular}{p{\linewidth}} (tabela de
% layout de coluna única, proibida por PDF/UA) por parágrafo direto.
% Interface preservada: \NomeNosCreditos{texto}
\newcommand{\NomeNosCreditos}[1]{%
    \sffamily\scriptsize\raggedright
    \noindent #1\par
}

% --- Lista de nomes em duas colunas (quebra de página automática) ---
% Substitui pares \parbox{0.49\linewidth} manuais, que não quebram
% página e causam overfull \vbox quando a lista é longa.
% Usa multicol: as colunas fluem por quantas páginas forem necessárias.
% Cada \\ vira \par, de modo que cada nome vira um parágrafo próprio
% na árvore de tags, preservando a ordem de leitura em PDF/UA.
\newenvironment{NomesDuasColunas}{%
    \begin{multicols}{2}%
    \begingroup
    \let\\\par
}{%
    \endgroup
    \end{multicols}%
}

% ---------------------------------------------------------------
% Camada Leg (módulo crpsp-leg.sty) — carga incondicional
% ---------------------------------------------------------------
% \InputIfFileExists em vez de \RequirePackage: o módulo mora ao
% lado deste .sty (crp@sty@dir, capturado no topo) e precisa ser
% encontrado também quando o pacote é carregado por caminho
% relativo. Ordem de busca: 1) diretório deste .sty (par deployado);
% 2) caminho de busca padrão do TeX (TEXINPUTS/cwd).
% (\makeatletter: este arquivo alterna catcode de @ por seção.)
\makeatletter
\InputIfFileExists{\crp@sty@dir crpsp-leg.sty}{}{%
    \InputIfFileExists{crpsp-leg.sty}{}{%
        \PackageError{livros_crp_acessivel_book}%
            {Modulo crpsp-leg.sty nao encontrado}%
            {O arquivo crpsp-leg.sty deve estar no mesmo diretorio
             deste pacote (os dois viajam juntos no deploy) ou no
             caminho de busca do TeX.}%
    }%
}
\makeatother

