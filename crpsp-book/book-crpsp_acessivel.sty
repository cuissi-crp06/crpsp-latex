% --- Layout da página ---
% Valores calculados a partir do \semiisopage do memoir para A5:
%   inner  = paperwidth  / 9 = 148/9  ≈ 16.444 mm
%   outer  = 2 * inner       ≈ 32.889 mm
%   top    = paperheight / 9 = 210/9  ≈ 23.333 mm
%   bottom = 2 * top         ≈ 46.667 mm
%   textwidth  = 148 - inner - outer  ≈ 98.667 mm
%   textheight = 210 - top   - bottom = 140.000 mm
%
% A proporção áurea das margens é aproximada pelo ratio 1:2 do
% memoir (spine:edge e top:bottom), que é a fórmula documentada
% de \semiisopage.
\usepackage[
    a5paper,
    inner      = 16.444mm,
    outer      = 32.889mm,
    top        = 23.333mm,
    bottom     = 30mm,
    headheight = 14pt,      % fancyhdr reclama se < 12.4pt
    headsep    = 1.618\baselineskip,
]{geometry}

% --- Sumário ---
\setcounter{tocdepth}{0}
\setcounter{secnumdepth}{-1}   % hierarquia via tags, sem numeração visível

% Espaçamento entre entradas de capítulo no sumário.
% O book.cls define \l@chapter com \addvspace{1.0em plus\p@} antes
% de cada entrada. Reduzimos para 0.5em para evitar que a última
% entrada transborde para uma página extra. O restante do corpo é
% idêntico ao book.cls 2025/01/22 v1.4n — atualizar se a classe
% mudar esta definição.
\makeatletter
\renewcommand*\l@chapter[2]{%
    \ifnum \c@tocdepth >\m@ne
        \addpenalty{-\@highpenalty}%
        \addvspace{0.5em \@plus\p@}%
        \setlength\@tempdima{1.5em}%
        \begingroup
            \parindent \z@ \rightskip \@pnumwidth
            \parfillskip -\@pnumwidth
            \leavevmode \bfseries
            \advance\leftskip\@tempdima
            \hskip -\leftskip
            #1\nobreak\hfil
            \nobreak\hb@xt@\@pnumwidth{\hss #2%
                \kern-\p@\kern\p@}\par
            \penalty\@highpenalty
        \endgroup
    \fi}
\makeatother

