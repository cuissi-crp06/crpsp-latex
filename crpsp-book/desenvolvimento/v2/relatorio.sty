%% relatorio.sty
%% Implementação de layout da linha Relatório A4 do CRP-SP:
%% geometria, tipografia, seccionamento, boxes paralelos, tabelas
%% com linha destacada, box de destaque, figuras com alt e — na
%% variante `externo` — a camada de decoração.
%% Requer: crpsp-relatorio.cls (que carrega crpsp-base.sty)
%%
%% ⚠️ REGRA DE ESCRITA DOS .tex DESTA LINHA: aspas Unicode reais
%% (“ ”, ‘ ’), nunca a convenção `` '' do TeX. A convenção passa pelo
%% glifo da CRASE (U+0060), que a Atkinson não tem — ver §2b. Com o
%% \tracinglostchars=3 desta linha, escrever `` '' é ERRO de
%% compilação, não aviso silencioso.
%%
\NeedsTeXFormat{LaTeX2e}[2023/11/01]
\ProvidesPackage{relatorio}[2026/09/28 v0.3.0-alfa Linha relatorio A4 CRP-SP]

\RequirePackage{etoolbox}

% ══════════════════════════════════════════════
%  1. GEOMETRIA
%
%  Margem de 35 mm nos QUATRO lados (decisão de 17/09/2026):
%    - mancha de 140 mm = ~75 caracteres em Atkinson 12 pt
%      (1,878 mm/car., medido no motor com kerning);
%    - a decoração do `externo` vai nas margens superior e inferior,
%      e são esses 35 mm que ela ocupa;
%    - como a exigência lateral é menor que a de manual/cartilha —
%      que precisam de margem externa para ilustração —, a lateral
%      fica simétrica e igual à vertical.
%
%  Altura: 227 mm de mancha, ~35 linhas por página com entrelinha
%  de 18 pt.
%
%  O fólio divide a faixa inferior com a arte: \relDecoracaoAltura
%  é o comprimento nomeado contra o qual o designer trabalha, e
%  \footskip põe o número de página a 12 mm da última linha, dentro
%  da faixa.
% ══════════════════════════════════════════════

\newlength{\relDecoracaoAltura}
\setlength{\relDecoracaoAltura}{35mm}

\geometry{%
  a4paper,
  top      = \relDecoracaoAltura,
  bottom   = \relDecoracaoAltura,
  left     = 35mm,
  right    = 35mm,
  footskip = 12mm,
}

% ══════════════════════════════════════════════
%  2. TIPOGRAFIA
%
%  Corpo: Atkinson Hyperlegible Next (Braille Institute, pacote
%  `atkinson` do TeX Live, sete pesos com itálicos). É a fonte que
%  esta linha já usava, e a decisão de 17/09 a manteve.
%
%  ⚠️ O que ela custa, registrado: altura-x de 2,092 mm — passa o
%  mínimo de 2,0 mm da RNIB, não a meta de 2,3 mm que a Luciole
%  (2,299) e a NEWJUNE (2,294) alcançam. A Atkinson busca
%  legibilidade por DIFERENCIAÇÃO DE LETRA (I/l/1, O/0, b/d), não
%  por altura-x: são dois critérios de acessibilidade distintos. Em
%  troca é a mais estreita das cinco medidas (10% menos que a
%  Luciole), e é isso que devolve os 35 mm de margem uniforme.
%
%  Títulos: NEWJUNE, a fonte institucional. É PROPRIETÁRIA e não
%  viaja com o pacote: a máquina que não a tiver não compila esta
%  linha, por decisão de 17/09/2026. O erro sai claro, pelo
%  \crpspExigeFonte da base.
%
%  ⚠️ Toda fonte é declarada por ARQUIVO, nunca por nome: por nome o
%  fontspec substitui a face em silêncio e devolve as métricas de
%  outro corte.
%
%  ⚠️ E NÃO BASTA O NOME DO ARQUIVO — tem de ser o CAMINHO. Achado de
%  17/09/2026: este Fedora tem duas Atkinson Hyperlegible Next, com
%  md5 diferentes (a do pacote `atkinson' do TeX Live e a do pacote
%  de fontes da distribuição, em /usr/share/fonts). Com o nome solto,
%  o luaotfload resolvia Regular e Bold pela cópia da distribuição e
%  o ITÁLICO pela do TeX Live: dois builds da mesma família no mesmo
%  PDF, e só um deles com o glifo U+0060. Daí o \crpsprel@atkinson
%  abaixo, que fixa o diretório pelo kpathsea — a cópia do TeX Live é
%  a dependência declarada, e é a que existe em qualquer máquina com
%  o pacote instalado.
% ══════════════════════════════════════════════

% Diretório da Atkinson do TeX Live, resolvido pelo kpathsea. Fixar o
% caminho é o que garante que os quatro cortes venham do mesmo build.
% O Lua só IMPRIME o diretório, e o \edef captura. Tentar montar um
% \def dentro do \directlua não funciona: o TeX expande o \string
% antes de o Lua ver a cadeia, e "\def" vira escape inválido em Lua.
% O -2 do tex.sprint imprime com catcode 12, para que caractere
% especial no caminho (~, _) não seja interpretado.
\edef\crpsprel@atkinson{%
  \directlua{
    local achado = kpse.find_file("AtkinsonHyperlegibleNext-Regular.otf",
                                  "opentype fonts")
    if achado then tex.sprint(-2, (achado:gsub("[^/]*$", ""))) end
  }%
}
\ifx\crpsprel@atkinson\@empty
  \PackageError{relatorio}{Atkinson Hyperlegible Next nao encontrada}{%
    O kpathsea nao resolveu AtkinsonHyperlegibleNext-Regular.otf.\MessageBreak
    Instale o pacote `atkinson' do TeX Live: tlmgr install atkinson%
  }%
\fi

\ifcrpsp@fontspec
  \crpspExigeFonte{AtkinsonHyperlegibleNext-Regular.otf}%
    {Atkinson Hyperlegible Next}%
    {pacote `atkinson' do TeX Live (tlmgr install atkinson)}%
  \crpspExigeFonte{NEWJUNE-REGULAR.OTF}%
    {NEWJUNE (institucional, proprietaria)}%
    {editorial/fonts/NewJune/ no Nextcloud}%
  \setmainfont{AtkinsonHyperlegibleNext}[
    Path           = \crpsprel@atkinson,
    UprightFont    = AtkinsonHyperlegibleNext-Regular.otf,
    ItalicFont     = AtkinsonHyperlegibleNext-RegularItalic.otf,
    BoldFont       = AtkinsonHyperlegibleNext-Bold.otf,
    BoldItalicFont = AtkinsonHyperlegibleNext-BoldItalic.otf,
    Ligatures      = TeX,
  ]
  \setsansfont{NEWJUNE}[
    UprightFont    = NEWJUNE-REGULAR.OTF,
    ItalicFont     = NEWJUNE-REGULAR-ITALIC.OTF,
    BoldFont       = NEWJUNE-BOLD.OTF,
    BoldItalicFont = NEWJUNE-BOLD-ITALIC.OTF,
    Ligatures      = TeX,
  ]
  \IfFontExistsTF{AtkinsonHyperlegibleMono-Regular.otf}{%
    \setmonofont{AtkinsonHyperlegibleMono}[
      Path           = \crpsprel@atkinson,
      UprightFont    = AtkinsonHyperlegibleMono-Regular.otf,
      ItalicFont     = AtkinsonHyperlegibleMono-RegularItalic.otf,
      BoldFont       = AtkinsonHyperlegibleMono-Bold.otf,
      BoldItalicFont = AtkinsonHyperlegibleMono-BoldItalic.otf,
    ]%
  }{}%
\else
  \PackageError{relatorio}{%
    Esta linha exige fontspec com luaotfload funcional%
  }{%
    Sem fontspec nao ha como declarar as fontes por arquivo, e\MessageBreak
    declarar por nome permitiria substituicao silenciosa da face.%
  }
\fi

% ══════════════════════════════════════════════
%  2b. FALHAR ALTO EM CARACTERE AUSENTE
%
%  ⚠️ Caractere que a fonte não tem sai do LaTeX como AVISO, e o PDF
%  fica com glifo sem mapeamento Unicode: o leitor de tela não tem o
%  que ler ali, e o PDF/UA exige mapeamento para TODO caractere. É
%  defeito silencioso — passa por zero erro fatal, zero erro de
%  tagging e zero transbordo.
%
%  Medido em 17/09/2026: a Atkinson não tem o glifo da CRASE
%  (U+0060), que é por onde a convenção `` '' do TeX monta as aspas.
%  Num único capítulo de teste deu 38 avisos `Missing character` e
%  aspas que o texto extraído devolvia como U+FFFD U+FFFD.
%
%  \tracinglostchars = 3 torna isso ERRO. O LaTeX usa 2 (aviso).
%  Fecha a classe inteira de defeito, para qualquer fonte e qualquer
%  caractere — não só para a crase.
% ══════════════════════════════════════════════
\AtBeginDocument{\tracinglostchars=3\relax}

% ══════════════════════════════════════════════
%  3. CORES DERIVADAS DA PALETA
%
%  A paleta institucional é ROXA e, nesta linha, FIXA (decisão de
%  17/09/2026). Os padrões vêm de crpsp-base §2; o documento pode
%  sobrescrevê-los pelos setters, mas não deveria.
%
%  Contrastes medidos sobre papel branco (WCAG):
%    cor1 Her Highness      #422C73 — 11,4:1  texto e títulos (AAA)
%    cor2 Midsummer Nights  #0511F2 —  8,9:1  links (AAA)
%    cor3 Royal Pretender   #A55DA6 —  4,45:1 SÓ elemento gráfico
%    alarme Piquant Pink    #EE05F2 —  3,54:1 SÓ borda/faixa/fundo
%
%  Piquant Pink NÃO passa como cor de texto. Ele entra apenas como
%  moldura (limiar 3:1 de elemento gráfico não-textual) e como fundo
%  tingido a 10%, sobre o qual o texto vai em preto (17:1).
% ══════════════════════════════════════════════

\definecolor{crpsp@alarme}{HTML}{EE05F2}
\definecolor{crpsp@tinta}{HTML}{0D0D0D}
\colorlet{alarme}{crpsp@alarme}
\colorlet{alarmefundo}{crpsp@alarme!10!white}
\colorlet{regua}{crpsp@cor3!45!white}

\newcommand{\crpspCorAlarme}[1]{%
  \definecolor{crpsp@alarme}{HTML}{#1}%
  \colorlet{alarme}{crpsp@alarme}%
  \colorlet{alarmefundo}{crpsp@alarme!10!white}%
}

\AtBeginDocument{\color{crpsp@tinta}}

\hypersetup{
  colorlinks = true,
  linkcolor  = crpsp@cor1,
  urlcolor   = crpsp@cor2,
  citecolor  = crpsp@cor2,
}

% ══════════════════════════════════════════════
%  4. SECCIONAMENTO
%     Via \@startsection — NUNCA titlesec, que é incompatível
%     com o tagging (WA-03: "number of automatic begin/end
%     text-unit para hooks differ").
%
%     Os skips foram relidos em 17/09 contra o \parskip do WCAG,
%     que nesta linha vale 1,5 x 18 pt = 27 pt:
%       - beforeskip MAIOR que o \parskip, senão o título não se
%         distingue de uma quebra de parágrafo qualquer;
%       - afterskip pequeno, porque o compensador do \@afterheading
%         (crpsp-base §4) já tira o \parskip do parágrafo que segue
%         o título. O resultado é o título perto do próprio texto e
%         longe do bloco anterior, que é o que a hierarquia pede.
%
%     Títulos em \sffamily = NEWJUNE. O contraste com o corpo é de
%     família, não de gênero: as duas são sem serifa.
%
%     ⚠️ REGRA DO NOME PRÓPRIO. Sob tagging, o \@startsection declara
%     uma instância GLOBAL por NOME de seção
%     (latex-lab-testphase-sec-template.sty:
%     \IfInstanceExistsF{heading}{#1-@startsection}). A PRIMEIRA
%     chamada de \@startsection{section} do documento congela
%     before-vspace, after-vspace e heading-decls para todas as
%     seguintes, que passam pelos próprios argumentos e os IGNORAM.
%     Toda macro de título com estilo próprio tem de usar um nome
%     próprio no primeiro argumento, ou sequestra o estilo da seção de
%     verdade. Achado no pe26 (plan-est_2026, quarta revisão,
%     25/09/2026): o título oculto dos créditos, que abre o documento
%     em 1 pt, pôs os nove títulos de seção do PDF em 1 pt preto. O
%     nível (segundo argumento) pode ser o mesmo: a árvore continua
%     com H1/H2/H3. O template exige um \<nome>mark. Ver §12.
% ══════════════════════════════════════════════

\setcounter{secnumdepth}{-1}

% Nota: o h2 do HTML de origem tem uma régua superior (border-top).
% Ela NÃO foi replicada aqui: emitir \hrule dentro do corpo do
% título de \@startsection insere material no bloco tagueado como
% cabeçalho. Se for desejada, o caminho seguro é uma régua explícita
% no documento (\crpspregua), não embutida no seccionamento.
\renewcommand\section{\@startsection{section}{1}{0pt}%
  {2\baselineskip}{0.5\baselineskip}%
  {\normalfont\sffamily\Large\bfseries\color{crpsp@cor1}}}
\renewcommand\subsection{\@startsection{subsection}{2}{0pt}%
  {1.5\baselineskip}{0.35\baselineskip}%
  {\normalfont\sffamily\large\bfseries\color{crpsp@cor1}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{0pt}%
  {1.2\baselineskip}{0.25\baselineskip}%
  {\normalfont\sffamily\normalsize\bfseries\color{crpsp@cor1}}}

% ══════════════════════════════════════════════
%  5. HELPERS DE TAGGING
%     \tagstructbegin/\tagstructend existem como no-ops
%     (tagpdf-base) quando o documento não ativa
%     \DocumentMetadata; o guard cobre formats sem tagpdf-base.
% ══════════════════════════════════════════════

\newcommand{\crpsprel@tagbegin}[1]{%
  \ifdefined\tagstructbegin\tagstructbegin{tag=#1}\fi
}
\newcommand{\crpsprel@tagend}{%
  \ifdefined\tagstructend\tagstructend\fi
}
\newcommand{\crpsprel@paraoff}{\ifdefined\tagpdfparaOff\tagpdfparaOff\fi}
\newcommand{\crpsprel@paraon}{\ifdefined\tagpdfparaOn\tagpdfparaOn\fi}

% Suspende a árvore de estrutura e marca o conteúdo do stream como
% ARTEFATO. É o par verificado em mwe_fundo_esopic.tex: sem o
% \tagmcbegin o conteúdo ficaria sem MC ("untagged content"); com
% \includegraphics[alt={}] viraria <Figure> de Alt vazio, que o
% veraPDF até aprova, mas que põe decoração na árvore de leitura.
% ⚠️ `alt={}` NÃO marca artefato desde agosto/2026 (WA-10), e a
% chave `artifact` do \includegraphics serve para arte NO FLUXO,
% não para fundo de shipout.
\newcommand{\crpsprel@artefatoinicio}{%
  \ifdefined\tagstop\tagstop\fi
  \ifdefined\tagmcbegin\tagmcbegin{artifact}\fi
}
\newcommand{\crpsprel@artefatofim}{%
  \ifdefined\tagmcend\tagmcend\fi
  \ifdefined\tagstart\tagstart\fi
}

% ══════════════════════════════════════════════
%  6. BOXES PARALELOS  —  \begin{paralelos} + \boxlado
%
%  Reproduz os cards da seção "As duas opções" do relatório HTML.
%
%  Implementação em \fcolorbox{\parbox}, NÃO tcolorbox: sob
%  tagging o patch do tcolorbox força \par em volta da box mesmo
%  com nobeforeafter, empilhando as colunas.
%  Validado em desenvolvimento/mwe/mwe_fcolorbox_phase3.tex.
%
%  A ordem das operações de tagging é decalque de colunas/\coluna
%  (guia-visual.sty §9) e é sensível:
%    abertura: \par, \topskip=0pt, paraoff, tagbegin{Sect}
%    cada box: tagbegin{Sect}, \parbox{ paraon <corpo>\par paraoff }, tagend
%    fecho:    \par, tagend, paraon
%  Duas armadilhas confirmadas empiricamente:
%    - sem o \par ANTES do paraoff interno, os hooks de parágrafo
%      ficam desbalanceados ("begin (12) and end (11) differ");
%    - invertendo \par e tagend no fecho, a pilha de estruturas
%      não fecha ("there is no open structure on the stack").
%
%  ⚠️ \parbox aplica \@parboxrestore, que ZERA o \parskip. Os boxes
%  restauram o valor a partir de \crpspParskip, que é o registro
%  que a crpsp-base §4 mantém justamente para isto.
% ══════════════════════════════════════════════

\newlength{\crpsprel@cardgap}
\setlength{\crpsprel@cardgap}{6mm}
\newlength{\crpsprel@cardwd}
\newlength{\crpsprel@cardparwd}
\newcounter{crpsprel@ncards}

\NewDocumentEnvironment{paralelos}{}{%
  \par
  % \topskip zerado (local ao ambiente): no topo da página o TeX
  % insere cola de \topskip menos a altura da primeira caixa; com
  % \parbox[t] essa altura é a da primeira linha, e a cola residual
  % estoura a mancha.
  \topskip=0pt\relax
  \setcounter{crpsprel@ncards}{0}%
  \setlength{\crpsprel@cardwd}{%
    \dimexpr(\linewidth-\crpsprel@cardgap)/2\relax}%
  \setlength{\fboxsep}{4.5mm}%
  \crpsprel@paraoff
  \crpsprel@tagbegin{Sect}%   container da linha de boxes
  \noindent\ignorespaces
}{%
  \par
  \crpsprel@tagend
  \crpsprel@paraon
  \ifnum\value{crpsprel@ncards}>2\relax
    \PackageWarning{relatorio}{%
      O ambiente 'paralelos' recebeu \the\value{crpsprel@ncards} boxes;
      o layout comporta 2.\MessageBreak
      Use dois ambientes consecutivos para mais cards.%
    }%
  \fi
}

% \boxlado[destaque]{rótulo}{título}{corpo}
%   sem opção  — moldura fina em cor3 (elemento gráfico, 4,45:1)
%   [destaque] — moldura grossa em alarme (3,54:1, acima do
%                limiar 3:1 de elemento gráfico não-textual)
% O rótulo vai SEMPRE em cor1 (11,4:1): a cor viva fica na moldura,
% nunca no texto.
\NewDocumentCommand{\boxlado}{O{} m m +m}{%
  \stepcounter{crpsprel@ncards}%
  \ifnum\value{crpsprel@ncards}>1\hspace{\crpsprel@cardgap}\fi
  \ifstrequal{#1}{destaque}{%
    \setlength{\fboxrule}{1.2pt}%
    \def\crpsprel@cardborda{crpsp@alarme}%
  }{%
    \setlength{\fboxrule}{0.4pt}%
    \def\crpsprel@cardborda{crpsp@cor3}%
  }%
  \setlength{\crpsprel@cardparwd}{%
    \dimexpr\crpsprel@cardwd-2\fboxsep-2\fboxrule\relax}%
  \crpsprel@tagbegin{Sect}%
  \fcolorbox{\crpsprel@cardborda}{white}{%
    \parbox[t]{\crpsprel@cardparwd}{%
      % alinha os TOPOS das duas caixas
      \vspace{0pt}%
      \setlength{\parskip}{\crpspParskip}%
      % medida estreita: o alinhamento à esquerda já vem da base
      \crpsprel@paraon
      {\sffamily\footnotesize\bfseries\color{crpsp@cor1}\MakeUppercase{#2}}\par
      {\sffamily\large\bfseries\color{crpsp@cor1}#3}\par
      #4\par
      \crpsprel@paraoff
    }%
  }%
  \crpsprel@tagend
  \ignorespaces
}

% ══════════════════════════════════════════════
%  7. BOX DE DESTAQUE  —  \begin{destaque}{rótulo}
%     Reproduz o callout "Caso documentado · 2026".
%     Largura da mancha, fundo tingido a 10% e moldura no tom
%     puro; todo o texto em preto sobre o fundo claro (17:1).
% ══════════════════════════════════════════════

\NewDocumentEnvironment{destaque}{m +b}{%
  \par
  \setlength{\fboxrule}{0.8pt}%
  \setlength{\fboxsep}{4.5mm}%
  \crpsprel@paraoff
  \crpsprel@tagbegin{Sect}%
  \noindent\fcolorbox{crpsp@alarme}{alarmefundo}{%
    \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
      \setlength{\parskip}{\crpspParskip}%
      \crpsprel@paraon
      {\sffamily\footnotesize\bfseries\color{crpsp@cor1}\MakeUppercase{#1}}\par
      #2\par
      \crpsprel@paraoff
    }%
  }%
  \par
  \crpsprel@tagend
  \crpsprel@paraon
}{}

% ══════════════════════════════════════════════
%  8. TABELAS  —  tabular / longtable + \rowcolor
%
%     NÃO tabularray: todo \end{tblr} emite relações de tag
%     inválidas ('text' --> 'text-unit') sob tagging, mesmo com
%     o módulo `table` ativo. Verificado em
%     desenvolvimento/mwe/mwe_tabelas_phase3.tex: tabular puro
%     taggeia limpo, tblr não — com ou sem colspec X, com ou sem
%     cor de linha.
%
%     tabular + \rowcolor, tabular com p{} + booktabs, e longtable
%     + \rowcolor foram todos verificados limpos
%     (mwe_tabelas2_phase3.tex).
%
%     Cabeçalho em cor1 com texto branco (11,4:1). Linha de
%     destaque com fundo de alarme a 10% — o ênfase vem de fundo
%     mais negrito, nunca de texto colorido.
%
%     PDF/UA proíbe tabular de LAYOUT; estas são de dados e têm
%     cabeçalho. Para blocos lado a lado use 'paralelos' (§6).
%
%     Uso:
%       \begin{tabular}{L{.35\linewidth}L{.55\linewidth}}
%         \linhacab \celcab{Etapa} & \celcab{Responsável} \\
%         Definição de pauta & ComCom \\
%         \linhadestaque \textbf{Checagem de fatos} & \textbf{Comunicação} \\
%       \end{tabular}
% ══════════════════════════════════════════════

% Tipo de coluna L{largura}: como p{}, mas alinhada à esquerda — use
% L{} em vez de p{} em toda coluna de texto de tabela. Desde que o
% alinhamento à esquerda virou regra da linha (WCAG 1.4.8, decisão de
% 17/09), o p{} justificado não deveria aparecer em lugar nenhum; o
% L{} continua existindo porque o array reinicia o alinhamento dentro
% da célula e não herda o \raggedright global.
%
% O \raggedright aqui é o do kernel — que sob tagging é a instância
% `para/raggedright` do latex-lab e marca /Layout /TextAlign /Start na
% célula, o mesmo atributo do corpo. Ver crpsp-base §4.
%
% Resíduo conhecido: células muito curtas em coluna estreita geram
% "Underfull \hbox (badness 10000)" — 4 ocorrências no relatório do
% Jornal Psi. É ruído métrico, não defeito: a folga à direita é o
% efeito pretendido do alinhamento à esquerda. O \hbadness dentro do
% >{} não é honrado pelo array nessas células.
\RequirePackage{array}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

% Fundo da linha de cabeçalho. Vai no INÍCIO da linha, antes da
% primeira célula.
\newcommand{\linhacab}{\rowcolor{crpsp@cor1}}

% Célula de cabeçalho: branco sobre cor1 = 11,4:1. É por célula
% porque \color no início da linha não atravessa o & no tabular.
\newcommand{\celcab}[1]{\textcolor{white}{\bfseries #1}}

% Linha realçada (o equivalente ao tr.gap do HTML de origem).
\newcommand{\linhadestaque}{\rowcolor{alarmefundo}}

% Marca de função sem responsável designado. Sem cor: o ênfase é
% tipográfico, porque Piquant Pink reprova como cor de texto.
\newcommand{\vago}{\textbf{--- vago}}

% ══════════════════════════════════════════════
%  9. LISTAS
%     Sem enumitem (sob tagging o latex-lab o substitui pela
%     emulação). Apenas recoloração dos rótulos padrão.
% ══════════════════════════════════════════════

\renewcommand{\labelitemi}{\textcolor{crpsp@cor1}{\textbullet}}
\renewcommand{\labelitemii}{\textcolor{crpsp@cor1}{--}}
\renewcommand{\labelenumi}{\textcolor{crpsp@cor1}{\arabic{enumi}.}}

% ══════════════════════════════════════════════
%  10. FIGURAS  —  \graficocrp{arquivo}{título}{alt}{fonte}
%     O alt é OBRIGATÓRIO: os gráficos entram como PDF
%     pré-renderizado, logo são imagem para o leitor de tela.
%     Toda figura deve ser acompanhada da tabela de dados
%     correspondente (equivalente ao <details> do HTML).
% ══════════════════════════════════════════════

\newcommand{\graficocrp}[4]{%
  \par
  \crpsprel@tagbegin{Sect}%
  {\normalfont\sffamily\large\bfseries\color{crpsp@cor1}#2\par}
  \nobreak
  \noindent\includegraphics[width=\linewidth, alt={#3}]{#1}\par
  \nobreak
  % A nota de fonte é TEXTO: vai em cinza escuro (10,4:1), não em cor3
  % (Royal Pretender, 4,45:1) — cor3 é reservada a elemento gráfico.
  {\footnotesize\color{crpsp@tinta!75!white}#4\par}
  \crpsprel@tagend
  \par
}

% ══════════════════════════════════════════════
%  11. VARIANTE `externo` — A CAMADA DE DECORAÇÃO
%
%  Só existe com \documentclass[externo]{crpsp-relatorio}. No
%  `interno` nada disto é definido, e o eso-pic nem é carregado.
%
%  A arte é do designer e ainda não existe: por isso tudo aqui é
%  INTERFACE com fallback. Sem arquivo, nada é impresso e nada
%  falha — quando a arte chegar, é um arquivo a mais, não uma
%  reescrita.
%
%    \relDecoracao{<topo>}{<pé>}  declara as faixas (preâmbulo)
%    \relCapaArte{<arquivo>}      declara a arte da capa (preâmbulo)
%    \relCapa                     compõe a capa (documento)
%    \relSemDecoracao / \relComDecoracao   liga e desliga as faixas
%
%  ⚠️ A decoração é ARTEFATO: entra pelo par \crpsprel@artefatoinicio
%  / \crpsprel@artefatofim (§5), nunca como \includegraphics com
%  alt={}. Verificar com show-pdf-tags.lua: zero <Figure> vindo daqui.
%
%  ⚠️ A capa NÃO usa pdfpages. O \includepdf é incompatível com
%  tagging (achado de 17/09/2026, pelo Guia de Apresentações
%  Acessíveis) e não pode entrar nesta linha.
%
%  EM ABERTO: o comportamento da decoração em páginas em paisagem.
%  A pendência é do briefing de 16/09 e segue aberta — esta linha
%  não carrega pdflscape, e anexos em paisagem ficam para a rodada
%  que resolver isso.
% ══════════════════════════════════════════════

% ⚠️ O \newif fica FORA do \ifcrpsp@rel@externo, e não por gosto. Ao
% pular um bloco condicional, o TeX não executa o \newif — mas o
% analisador de salto também não reconhece \ifcrpsprel@decora como
% condicional, porque ainda é um controle indefinido. O \fi
% correspondente, esse ele conta: o bloco inteiro fecha cedo demais e
% o erro sai a dezenas de linhas dali ("Too many }'s" seguido de
% "Extra \fi"). Todo \newif de um bloco opcional tem de nascer antes
% dele.
\newif\ifcrpsprel@decora \crpsprel@decoratrue

\ifcrpsp@rel@externo

  \RequirePackage{eso-pic}

  \newcommand{\relSemDecoracao}{\crpsprel@decorafalse}
  \newcommand{\relComDecoracao}{\crpsprel@decoratrue}

  \def\crpsprel@artetopo{}
  \def\crpsprel@artepe{}
  \def\crpsprel@artecapa{}

  \newcommand{\relDecoracao}[2]{%
    \def\crpsprel@artetopo{#1}%
    \def\crpsprel@artepe{#2}%
  }
  \newcommand{\relCapaArte}[1]{\def\crpsprel@artecapa{#1}}

  % Uma faixa com a largura do papel e a altura da faixa de decoração.
  % Há duas porque a âncora difere: a do topo precisa descer a própria
  % altura (o \AtPageUpperLeft ancora o canto superior esquerdo do
  % papel, e o \includegraphics cresce para cima a partir da linha de
  % base). \IfFileExists é a guarda: arte declarada mas ausente avisa e
  % segue — a compilação não para por falta do designer.
  \newcommand{\crpsprel@arte}[1]{%
    \includegraphics[width=\paperwidth, height=\relDecoracaoAltura]{#1}%
  }
  \newcommand{\crpsprel@faltou}[1]{%
    \PackageWarning{relatorio}{%
      Arte de decoracao `#1' nao encontrada; a faixa fica vazia%
    }%
  }

  \newcommand{\crpsprel@faixatopo}{%
    \ifx\crpsprel@artetopo\@empty\else
      \IfFileExists{\crpsprel@artetopo}{%
        \AtPageUpperLeft{%
          \raisebox{-\relDecoracaoAltura}[0pt][0pt]{%
            \crpsprel@arte{\crpsprel@artetopo}}%
        }%
      }{\crpsprel@faltou{\crpsprel@artetopo}}%
    \fi
  }
  \newcommand{\crpsprel@faixape}{%
    \ifx\crpsprel@artepe\@empty\else
      \IfFileExists{\crpsprel@artepe}{%
        \AtPageLowerLeft{\crpsprel@arte{\crpsprel@artepe}}%
      }{\crpsprel@faltou{\crpsprel@artepe}}%
    \fi
  }

  \AddToShipoutPictureBG{%
    \ifcrpsprel@decora
      \crpsprel@artefatoinicio
      \crpsprel@faixatopo
      \crpsprel@faixape
      \crpsprel@artefatofim
    \fi
  }

  % \relCapa — página inteira, sem fólio e sem as faixas.
  % Com arte: imagem full-bleed, marcada como artefato.
  % Sem arte: capa tipográfica com \title, \author e \date, na paleta
  % institucional. As duas caem na mesma página, e o documento não
  % precisa saber qual saiu.
  \newcommand{\relCapa}{%
    \relSemDecoracao
    \thispagestyle{empty}%
    \crpsprel@capaarte
    \clearpage
    \relComDecoracao
  }

  \newcommand{\crpsprel@capaarte}{%
    \ifx\crpsprel@artecapa\@empty
      \crpsprel@capatipografica
    \else
      \IfFileExists{\crpsprel@artecapa}{%
        \AddToShipoutPictureBG*{%
          \crpsprel@artefatoinicio
          \AtPageLowerLeft{%
            \includegraphics[width=\paperwidth,
                             height=\paperheight]{\crpsprel@artecapa}}%
          \crpsprel@artefatofim
        }%
        \null
      }{%
        \PackageWarning{relatorio}{%
          Arte de capa `\crpsprel@artecapa' nao encontrada;
          usando a capa tipografica%
        }%
        \crpsprel@capatipografica
      }%
    \fi
  }

  % Fallback tipográfico. Enquanto o designer não responde, é esta que
  % sai — e ela precisa ser uma capa apresentável, não um remendo.
  % \@title é obrigatório: uma capa sem título não é capa, e o
  % \hypersetup{pdftitle} que o veraPDF exige já obriga a ter um.
  % Com \relRosto declarado, sai a folha de rosto (abaixo).
  \newcommand{\crpsprel@capatipografica}{%
    \ifdefined\@title\else
      \PackageError{relatorio}{\string\relCapa\space sem \string\title}{%
        A capa tipografica compoe \string\@title, \string\@author\space e
        \string\@date.\MessageBreak
        Declare ao menos \string\title{...} no preambulo.%
      }%
      \gdef\@title{}%
    \fi
    \ifx\crpsprel@rostologo\@empty
      \expandafter\crpsprel@capaclassica
    \else
      \expandafter\crpsprel@folharosto
    \fi
  }

  % Folha de rosto — variante da capa tipográfica, pedida pelo editor
  % do pe26 (plan-est_2026, quarta revisão, 25/09/2026): título no
  % centro da página e logotipo no pé. Sem o fio e sem autor/data —
  % o logotipo já nomeia a instituição, e repetir seria redundância
  % para quem lê com os olhos e para quem lê com leitor de tela.
  %
  %   \relRosto{<arquivo do logotipo>}{<alt>}   liga a variante (preâmbulo)
  %   \crpspRostoTitulo                         o título impresso; padrão
  %                                              \@title, redefinível para
  %                                              quebrar a linha sem mexer
  %                                              no \title (que alimenta os
  %                                              metadados)
  %   \crpspRostoLogoLargura                    comprimento; 0,62 \linewidth
  %
  % ⚠️ O logotipo é IMAGEM, não artefato: é ele que identifica quem
  % publica, e sumiria para o leitor de tela se entrasse como
  % decoração. Por isso o `alt' é obrigatório (UA-2), e o logotipo não
  % passa pelo par \crpsprel@artefatoinicio/fim das faixas.
  \def\crpsprel@rostologo{}
  \def\crpsprel@rostoalt{}
  \newcommand{\relRosto}[2]{%
    \IfBlankT{#2}{%
      \PackageError{relatorio}{\string\relRosto\space sem texto alternativo}{%
        O logotipo da folha de rosto identifica quem publica e precisa\MessageBreak
        de alt: \string\relRosto{arquivo}{Logotipo do ...}.%
      }%
    }%
    \def\crpsprel@rostologo{#1}%
    \def\crpsprel@rostoalt{#2}%
  }
  \newcommand{\crpspRostoTitulo}{\@title}
  \newlength{\crpspRostoLogoLargura}
  \AtBeginDocument{\setlength{\crpspRostoLogoLargura}{0.62\linewidth}}

  \newcommand{\crpsprel@folharosto}{%
    \null
    \vfill
    {\centering
      \sffamily\crpspTituloCapa\bfseries\color{crpsp@cor1}
      \crpspRostoTitulo\par}%
    \vfill
    {\centering
      \includegraphics[width=\crpspRostoLogoLargura,
                       alt={\crpsprel@rostoalt}]{\crpsprel@rostologo}\par}%
    \vskip 2\baselineskip
  }

  \newcommand{\crpsprel@capaclassica}{%
    \null
    \vskip 4\baselineskip
    {\raggedright
      {\sffamily\crpspTituloCapa\bfseries\color{crpsp@cor1}\@title\par}%
      \vskip 1.5\baselineskip
      {\color{crpsp@cor3}\rule{\linewidth}{2pt}}\par
      \vskip 1.5\baselineskip
      \ifdefined\@author
        \ifx\@author\@empty\else
          {\sffamily\large\color{crpsp@tinta}\@author\par}%
        \fi
      \fi
      \ifdefined\@date
        \ifx\@date\@empty\else
          \vskip 0.5\baselineskip
          {\sffamily\color{crpsp@tinta}\@date\par}%
        \fi
      \fi
    }%
    \vfill
  }

\fi

% ══════════════════════════════════════════════
%  12. CRÉDITOS  —  modelo do Relatório de Gestão
%
%  Vale para as duas variantes. Veio do comum.tex §5 do pe26
%  (plan-est_2026, 24–25/09/2026), validado no
%  mwe/mwe_creditos_titulo_invisivel.tex (veraPDF ua2 PASS; página
%  idêntica à sem título). As armadilhas estão documentadas lá; aqui
%  ficam os lembretes. É também a interface que o gerador de créditos
%  do normativas-pipeline escreve: mudar um nome aqui quebra os .tex
%  gerados em editorial/creditos/.
%
%  Títulos — todos não numerados e fora do sumário:
%    \creditosoculto{<título>}  nível 1, com tag e SEM impressão; abre
%                               página nova
%    \creditosgrupo{<grupo>}    nível 2 (\subsection*), com fio
%    \creditossub{<subgrupo>}   nível 3, instância própria
%    \creditos{<título>}        nível 1, visível, sem quebra (ficha
%                               técnica)
%
%  Nomes (interface do book 0.5.1, com o registro separado do nome —
%  decisão de 17/09/2026):
%    \NomeNosCreditos{nome}{registro}[nota]   uma pessoa por parágrafo;
%                                  o registro num Span próprio; a nota
%                                  ([licenciada]) depois, com travessão
%    \NomeNosCreditos{nome (CRP~06/nº)}       forma antiga, com aviso
%    \CargoNosCreditos[registro]{nome}{cargo} cargos alinhados
%    CreditoInstitucional       bloco, com espaço curto entre pessoas
%    NomesDuasColunas           duas colunas, registro embaixo
%
%  Comprimentos ajustáveis (\setlength depois do \begin{document}):
%    \crpspCreditosSep       entre pessoas (0,3 \baselineskip) — exceção
%                            ao \parskip do WCAG numa lista de nomes
%    \crpspCreditosAposFio   fio do grupo -> título de subgrupo
%    \crpspCreditosAnteSub   texto -> próximo título de subgrupo
%    \crpspCreditosNome      coluna do nome no \CargoNosCreditos
%    \crpspCreditosVao       vão entre nome e cargo
%
%  ⚠️ O NomesDuasColunas usa o multicol, que a classe tinha na lista do
%  que não carregar (crpsp-relatorio.cls §3). O uso daqui foi validado
%  sob tagging (um P por pessoa, ordem coluna 1 → coluna 2); texto
%  corrido em colunas continua fora.
% ══════════════════════════════════════════════

\RequirePackage{needspace}
\RequirePackage{multicol}
\RequirePackage{pdfrender}

% ⚠️ \Needspace, e não \needspace: o minúsculo só oferece um ponto de
% quebra por cola, e o page builder decide depois. Pulado logo depois
% de outro título (\if@nobreak), onde o \penalty seria um ponto de
% quebra ENTRE os dois títulos.
\newcommand{\crpsprel@titulo@antes}[1]{%
  \if@nobreak\else\Needspace{#1\baselineskip}\fi
}

% \creditos usa o nome `section' de propósito: é título de seção de
% verdade (a ficha técnica), e o estilo é o da §4.
\newcommand{\creditos}[1]{%
  \crpsprel@titulo@antes{7}%
  \@startsection{section}{1}{0pt}%
    {2\baselineskip}{0.5\baselineskip}%
    {\normalfont\sffamily\Large\bfseries\color{crpsp@cor1}}*{#1}}

% Título invisível: nome próprio (regra da §4), texto em Tr 3 (lido,
% extraído, não pintado), linha de altura, profundidade e largura
% zero, e \topskip emulado pelo \prevdepth para o título seguinte cair
% onde cairia sem ele.
% ⚠️ A emulação supõe que o próximo é um \creditosgrupo (\large).
\newcommand{\crpspsecaoocultamark}[1]{}
\newlength{\crpsprel@bs@grupo}
\AtBeginDocument{{\large\global\crpsprel@bs@grupo=\baselineskip}}
\newcommand{\creditosoculto}[1]{%
  \clearpage
  \@startsection{crpspsecaooculta}{1}{0pt}{0pt}{1sp}%
    {\normalfont\fontsize{1pt}{0pt}\selectfont}%
    *{\texorpdfstring{\smash{\rlap{%
      \textpdfrender{TextRenderingMode=Invisible}{\normalsize #1}}}}{#1}}%
  \par
  \vskip-\topskip
  \prevdepth=\dimexpr\crpsprel@bs@grupo-\topskip\relax
}

% Nível 2, com fio. O fio é artefato e vai em modo vertical (\hrule):
% \rule num parágrafo com o tagging suspenso desbalanceia os hooks.
% O \vspace{\parskip} devolve o desconto do \@afterheading, que punha
% o fio acima do título; o desconto é refeito depois do fio.
% O \crpspCreditosAnteSub só age quando o subgrupo NÃO vem logo depois
% do fio: ali o \@afterheading já suprimiu o espaço anterior.
\newlength{\crpspCreditosAposFio}
\newlength{\crpspCreditosAnteSub}
\AtBeginDocument{%
  \setlength{\crpspCreditosAposFio}{0.8\baselineskip}%
  \setlength{\crpspCreditosAnteSub}{0.9\baselineskip}}

\newcommand{\creditosgrupo}[1]{%
  \subsection*{#1}%
  \vspace{\parskip}\vspace{2pt}%
  \crpsprel@artefatoinicio
  {\color{crpsp@cor3}\hrule height 1pt\relax}%
  \crpsprel@artefatofim
  \vspace{-\parskip}\vspace{\crpspCreditosAposFio}%
}

% Nome próprio pela regra da §4: as subsubseções dos créditos vêm
% antes das do corpo, e congelariam os vãos delas.
\newcommand{\crpspcreditossubmark}[1]{}
\newcommand{\creditossub}[1]{%
  \@startsection{crpspcreditossub}{3}{0pt}%
    {\crpspCreditosAnteSub}{0.25\baselineskip}%
    {\normalfont\sffamily\normalsize\bfseries\color{crpsp@cor1}}*{#1}}

% multicols logo depois de título: não abre parágrafo e não devolve o
% \parskip descontado pelo \@afterheading.
\AddToHook{env/multicols/before}{\if@nobreak\vspace{\parskip}\fi}

\ExplSyntaxOn
% Registro num Span: fecha o MC do parágrafo, abre o do Span e reabre
% o do parágrafo (par push/pop do tagpdf).
\cs_new_protected:Npn \crpsprel_creditos_registro:n #1
  {
    \tag_mc_end_push:
    \tag_struct_begin:n { tag = Span }
    \tag_mc_begin:n { }
    #1
    \tag_mc_end:
    \tag_struct_end:
    \tag_mc_begin_pop:n { }
  }
\cs_new_eq:NN \crpsprel@registro \crpsprel_creditos_registro:n
\ExplSyntaxOff
\newcommand{\crpsprel@registro@sep}{ }
\newcommand{\crpsprel@registro@fmt}[1]{(CRP~#1)}

% Forma nova e antiga no mesmo nome: se depois do nome vier `{', é a
% nova. ⚠️ Na antiga, um `{' logo depois seria engolido como registro.
\ExplSyntaxOn
\NewDocumentCommand{\NomeNosCreditos}{m}
  {
    \peek_catcode_ignore_spaces:NTF \c_group_begin_token
      { \crpsprel_creditos_nome:nn {#1} }
      {
        \msg_warning:nn { relatorio } { nome-antigo }
        \par\noindent #1 \par
      }
  }
\cs_new_protected:Npn \crpsprel_creditos_nome:nn #1#2
  {
    \peek_charcode_ignore_spaces:NTF [
      { \crpsprel_creditos_nome_nota:nnw {#1} {#2} }
      { \crpsprel_creditos_nome:nnn {#1} {#2} { } }
  }
\cs_new_protected:Npn \crpsprel_creditos_nome_nota:nnw #1#2[#3]
  { \crpsprel_creditos_nome:nnn {#1} {#2} { ~—~#3 } }
\cs_new_protected:Npn \crpsprel_creditos_nome:nnn #1#2#3
  {
    \par\noindent\hangindent=1em\hangafter=1\relax
    #1 \crpsprel@registro@sep \crpsprel@registro { \crpsprel@registro@fmt {#2} } #3
    \par
  }
\msg_new:nnn { relatorio } { nome-antigo }
  {
    \iow_char:N\\NomeNosCreditos~de~um~argumento~está~deprecado:~use~
    \iow_char:N\\NomeNosCreditos\{nome\}\{registro\}.
  }
\ExplSyntaxOff

% \CargoNosCreditos[registro]{nome}{cargo}: cargos ALINHADOS na
% vertical. Nome e registro numa \parbox de largura fixa
% (\crpspCreditosNome), o cargo em outra. Tagging do `paralelos' (§6):
% a pessoa é um Div, cada \parbox abre o seu P; leitura nome →
% registro (Span) → cargo. O registro vai sempre na linha de baixo.
% Validado no MWE (variante E), veraPDF ua2.
\newlength{\crpspCreditosNome}
\newlength{\crpspCreditosVao}
\AtBeginDocument{%
  \setlength{\crpspCreditosNome}{0.56\linewidth}%
  \setlength{\crpspCreditosVao}{1em}}
\newcommand{\crpsprel@cargo@alinhado}[3]{% #1 registro (ou vazio), #2 nome, #3 cargo
  \par
  \crpsprel@paraoff
  \crpsprel@tagbegin{Div}%
  \noindent
  \parbox[t]{\crpspCreditosNome}{%
    \raggedright\hangindent=1em\hangafter=1\relax
    \crpsprel@paraon
    \textbf{#2}%
    \ifx\relax#1\relax\else\newline\crpsprel@registro{\crpsprel@registro@fmt{#1}}\fi
    \par\crpsprel@paraoff}%
  \hspace{\crpspCreditosVao}%
  \parbox[t]{\dimexpr\linewidth-\crpspCreditosNome-\crpspCreditosVao\relax}{%
    \raggedright
    \crpsprel@paraon
    #3\par\crpsprel@paraoff}%
  \par
  \crpsprel@tagend
  \crpsprel@paraon
}
\NewDocumentCommand{\CargoNosCreditos}{o m m}{%
  \IfValueTF{#1}{\crpsprel@cargo@alinhado{#1}}{\crpsprel@cargo@alinhado{}}{#2}{#3}}

% Uma pessoa não se parte entre colunas nem entre páginas (no pe26 o
% registro de uma pessoa foi parar na página seguinte).
\newcommand{\crpsprel@creditos@inteiros}{%
  \interlinepenalty=10000 \clubpenalty=10000 \widowpenalty=10000 }

\newlength{\crpspCreditosSep}
\AtBeginDocument{\setlength{\crpspCreditosSep}{0.3\baselineskip}}
% Logo depois de título, o \@afterheading já descontou o \parskip
% inteiro, e o primeiro parágrafo daqui só devolve o \crpspCreditosSep.
\newenvironment{CreditoInstitucional}
  {\par
   \if@nobreak\vspace{\dimexpr\parskip-\crpspCreditosSep\relax}\fi
   \begingroup\setlength{\parskip}{\crpspCreditosSep}%
   \crpsprel@creditos@inteiros}
  {\par\endgroup}

% O do book (multicols, \\ vira \par), com o registro na linha de baixo
% e o \multicolsep zerado (punha 17,6 pt entre título e primeiro nome).
\newenvironment{NomesDuasColunas}{%
  \par\begingroup
  \setlength{\multicolsep}{0pt}%
  \begin{multicols}{2}%
  \begingroup
  \raggedright
  \setlength{\parskip}{\crpspCreditosSep}%
  \crpsprel@creditos@inteiros
  \let\\\par
  \renewcommand{\crpsprel@registro@sep}{\newline}%
}{%
  \endgroup
  \end{multicols}%
  \endgroup
}

\endinput
